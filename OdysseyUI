-- Toggle row (returns the toggle button; connect .MouseButton1Click)
local function ToggleRow(labelText, defaultOn, parent)
    local row = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        Parent = parent,
    })

    Create("TextLabel", {
        Text = labelText,
        TextSize = 11,
        Font = Enum.Font.Code,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -38, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local enabled = defaultOn or false

    local track = Create("Frame", {
        Size = UDim2.new(0, 28, 0, 15),
        Position = UDim2.new(1, -30, 0.5, -7),
        BackgroundColor3 = enabled and Theme.Accent or Theme.BG0,
        BorderSizePixel = 0,
        Parent = row,
    })
    Corner(track, 2)
    Stroke(track, enabled and Theme.Accent or Theme.Border, 1)

    local thumb = Create("Frame", {
        Size = UDim2.new(0, 9, 0, 9),
        Position = enabled and UDim2.new(1, -11, 0.5, -4) or UDim2.new(0, 2, 0.5, -4),
        BackgroundColor3 = enabled and Theme.White or Theme.TextMuted,
        BorderSizePixel = 0,
        Parent = track,
    })
    Corner(thumb, 2)

    -- Click hitbox
    local btn = Create("TextButton", {
        Text = "",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Parent = row,
    })

    btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        local tweenInfo = TweenInfo.new(0.12)
        TweenService:Create(track, tweenInfo, {
            BackgroundColor3 = enabled and Theme.Accent or Theme.BG0,
        }):Play()
        TweenService:Create(thumb, tweenInfo, {
            Position = enabled and UDim2.new(1, -11, 0.5, -4) or UDim2.new(0, 2, 0.5, -4),
            BackgroundColor3 = enabled and Theme.White or Theme.TextMuted,
        }):Play()
    end)

    return row
end

-- Slider row
local function SliderRow(labelText, minVal, maxVal, defaultVal, parent)
    local row = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        Parent = parent,
    })

    local lbl = Create("TextLabel", {
        Text = labelText,
        TextSize = 10,
        Font = Enum.Font.Code,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.7, 0, 0, 14),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local valLbl = Create("TextLabel", {
        Text = tostring(defaultVal),
        TextSize = 10,
        Font = Enum.Font.Code,
        TextColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        Size = UDim2.new(0.3, 0, 0, 14),
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    })

    -- Track
    local track = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 0, 20),
        BackgroundColor3 = Theme.BG0,
        BorderSizePixel = 0,
        Parent = row,
    })
    Stroke(track, Theme.Border, 1)

    local pct = (defaultVal - minVal) / (maxVal - minVal)

    local fill = Create("Frame", {
        Size = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })

    local thumb = Create("TextButton", {
        Text = "",
        Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new(pct, -5, 0.5, -5),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    Corner(thumb, 2)

    -- Dragging
    local draggingSlider = false
    thumb.MouseButton1Down:Connect(function() draggingSlider = true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if draggingSlider and i.UserInputType == Enum.UserInputType.MouseMovement then
            local relX = i.Position.X - track.AbsolutePosition.X
            local p = math.clamp(relX / track.AbsoluteSize.X, 0, 1)
            local val = math.floor(minVal + p * (maxVal - minVal))
            valLbl.Text = tostring(val)
            fill.Size = UDim2.new(p, 0, 1, 0)
            thumb.Position = UDim2.new(p, -5, 0.5, -5)
        end
    end)

    return row
end

-- Action button
local function ActionBtn(text, parent)
    local btn = Create("TextButton", {
        Text = text,
        TextSize = 10,
        Font = Enum.Font.Code,
        TextColor3 = Theme.Text,
        BackgroundColor3 = Theme.BG0,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 26),
        Parent = parent,
    })
    Corner(btn, 2)
    Stroke(btn, Theme.Border, 1)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {TextColor3 = Theme.Accent}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {TextColor3 = Theme.Text}):Play()
    end)
    return btn
end


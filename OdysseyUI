local function NavIcon(icon, id, order, disabled, tip)
    local btn=Btn(icon,14,disabled and T.TextMuted or T.TextDim,Color3.new(0,0,0))
    btn.BackgroundTransparency=1
    btn.Size=UDim2.new(1,0,0,30)
    btn.LayoutOrder=order
    btn.AutoButtonColor=false
    btn.Parent=SideList
    Corner(btn,7)
    if tip then AddTooltip(btn, tip) end

    local bar=New("Frame",{
        Size=UDim2.new(0,2,0,16),Position=UDim2.new(0,-2,0.5,-8),
        BackgroundColor3=T.Accent,BorderSizePixel=0,Visible=false,Parent=btn,
    })
    Corner(bar,1)

    if not disabled and id then
        table.insert(NavBtns,{btn=btn,bar=bar,id=id})
        btn.MouseButton1Click:Connect(function()
            for _,nb in ipairs(NavBtns) do
                nb.btn.BackgroundTransparency=1
                nb.btn.TextColor3=T.TextDim
                nb.bar.Visible=false
                if Pages[nb.id] then Pages[nb.id].Visible=false end
            end
            btn.BackgroundTransparency=0
            btn.BackgroundColor3=T.BG2
            btn.TextColor3=T.Text
            bar.Visible=true
            if Pages[id] then Pages[id].Visible=true end
        end)
    end
    return btn,bar
end


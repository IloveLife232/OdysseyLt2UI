local NavButtons = {}

local function NavIcon(icon, pageId, order, disabled)
    local btn = Create("TextButton", {
        Text = icon,
        TextSize = 15,
        Font = Enum.Font.GothamBold,
        TextColor3 = disabled and Theme.TextMuted or Theme.TextDim,
        BackgroundColor3 = Theme.BG0,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 34),
        LayoutOrder = order,
        Parent = NavList,
    })
    Corner(btn, 3)

    -- Active indicator bar
    local bar = Create("Frame", {
        Size = UDim2.new(0, 2, 0, 18),
        Position = UDim2.new(0, 0, 0.5, -9),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Visible = false,
        Parent = btn,
    })

    if not disabled and pageId then
        table.insert(NavButtons, {btn = btn, bar = bar, pageId = pageId})
        btn.MouseButton1Click:Connect(function()
            -- Deactivate all
            for _, nb in ipairs(NavButtons) do
                nb.btn.BackgroundTransparency = 1
                nb.btn.TextColor3 = Theme.TextDim
                nb.bar.Visible = false
                if Pages[nb.pageId] then
                    Pages[nb.pageId].Visible = false
                end
            end
            -- Activate this
            btn.BackgroundTransparency = 0
            btn.BackgroundColor3 = Theme.BG3
            btn.TextColor3 = Theme.Accent
            bar.Visible = true
            if Pages[pageId] then
                Pages[pageId].Visible = true
            end
        end)
    end

    return btn, bar
end


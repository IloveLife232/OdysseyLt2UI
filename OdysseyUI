        BackgroundColor3=enabled and T.Accent or T.BG3,BorderSizePixel=0,Parent=row,
    })
    Corner(track,8); Stroke(track,enabled and T.AccentDim or T.Border,1)
    local thumb=New("Frame",{
        Size=UDim2.new(0,10,0,10),
        Position=enabled and UDim2.new(1,-12,0.5,-5) or UDim2.new(0,2,0.5,-5),

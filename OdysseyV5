-- ============================================================
-- INTERNAL HELPERS
-- ============================================================
local function New(class, props)
    local o = Instance.new(class)
    for k,v in pairs(props) do o[k]=v end
    return o
end

local function Corner(p, r)
    local c = Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r or 6); c.Parent=p
end

local function Stroke(p, col, th)
    -- remove old stroke first
    local old = p:FindFirstChildWhichIsA("UIStroke")
    if old then old:Destroy() end
    local s = Instance.new("UIStroke"); s.Color=col or T.Border; s.Thickness=th or 1; s.Parent=p
    return s
end

local function Pad(p, t,r,b,l)
    local u = Instance.new("UIPadding")
    u.PaddingTop=UDim.new(0,t or 8); u.PaddingRight=UDim.new(0,r or 8)
    u.PaddingBottom=UDim.new(0,b or 8); u.PaddingLeft=UDim.new(0,l or 8)
    u.Parent=p
end

local function VList(p, gap)
    local l = Instance.new("UIListLayout")
    l.FillDirection=Enum.FillDirection.Vertical
    l.Padding=UDim.new(0,gap or 6)
    l.SortOrder=Enum.SortOrder.LayoutOrder
    l.Parent=p
    return l
end

local function MakeDraggable(frame, handle)
    local drag,start,spos=false
    handle.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true; start=i.Position; spos=frame.Position end
    end)
    handle.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
            local d=i.Position-start
            frame.Position=UDim2.new(spos.X.Scale,spos.X.Offset+d.X,spos.Y.Scale,spos.Y.Offset+d.Y)
        end
    end)
end

local function formatTime(s)
    return string.format("%d:%02d", math.floor(s/60), s%60)
end

-- Tooltip
local TooltipGui = New("ScreenGui",{Name="OdysseyTooltip",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,Parent=PlayerGui})
local TooltipFrame = New("Frame",{Name="Tooltip",Size=UDim2.new(0,190,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=T.BG1,BorderSizePixel=0,ZIndex=200,Visible=false,Parent=TooltipGui})
Corner(TooltipFrame,6); Stroke(TooltipFrame,T.Border,1); Pad(TooltipFrame,6,10,6,10)
local TooltipLbl=New("TextLabel",{Text="",TextSize=10,TextColor3=T.TextDim,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=201,Parent=TooltipFrame})

local function AddTooltip(obj, text)
    if not text or text=="" then return end
    obj.MouseEnter:Connect(function() TooltipLbl.Text=text; TooltipFrame.Visible=true end)
    obj.MouseLeave:Connect(function() TooltipFrame.Visible=false end)
    UserInputService.InputChanged:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseMovement and TooltipFrame.Visible then
            TooltipFrame.Position=UDim2.new(0,i.Position.X+14,0,i.Position.Y+14)
        end
    end)
end

-- ============================================================
-- ELEMENT BUILDERS (internal)
-- ============================================================

local function _makeRow(parent, order)
    local f = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,LayoutOrder=order or 0,Parent=parent})
    return f
end

local function _divider(parent, order)
    local f = New("Frame",{Size=UDim2.new(1,0,0,1),BackgroundColor3=T.Border,BorderSizePixel=0,LayoutOrder=order or 0,Parent=parent})
    return f
end

-- ============================================================
-- TAB CLASS
-- ============================================================
local Tab = {}
Tab.__index = Tab

function Tab:_getList()
    return self._list
end

function Tab:CreateSection(name)
    local row = _makeRow(self._list, self._order)
    self._order = self._order + 1

    local lbl = New("TextLabel",{
        Text=name:upper(), TextSize=9, TextColor3=T.TextMuted,
        Font=Enum.Font.GothamBold, BackgroundTransparency=1,
        Size=UDim2.new(1,0,0,14), TextXAlignment=Enum.TextXAlignment.Left,
        Parent=row,
    })

    -- Section also returns a table so you can add elements inside it
    local sectionProxy = setmetatable({_list=self._list, _order=self._order}, Tab)
    return sectionProxy
end

function Tab:CreateDivider()
    _divider(self._list, self._order)
    self._order = self._order + 1
end

function Tab:CreateLabel(opts)
    opts = opts or {}
    local text = opts.Text or "Label"
    local style = opts.Style or 1

    local colors = {T.TextDim, T.Blue, T.Yellow}
    local icons  = {"", "i  ", "! "}

    local row = _makeRow(self._list, self._order); self._order=self._order+1
    local lbl = New("TextLabel",{
        Text=(icons[style] or "")..text,
        TextSize=11, TextColor3=colors[style] or T.TextDim,
        Font=Enum.Font.Gotham, BackgroundTransparency=1,
        Size=UDim2.new(1,0,0,16), TextXAlignment=Enum.TextXAlignment.Left,
        TextWrapped=true, Parent=row,
    })

    local api = {}
    function api:Set(o) if o.Text then lbl.Text=o.Text end end
    function api:Destroy() row:Destroy() end
    return api
end

function Tab:CreateParagraph(opts)
    opts = opts or {}
    local row = _makeRow(self._list, self._order); self._order=self._order+1
    local inner = New("Frame",{BackgroundColor3=T.BG2,BorderSizePixel=0,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
    Corner(inner,8); Stroke(inner,T.Border,1); Pad(inner,8,10,8,10)
    local vl = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=inner}); VList(vl,4)
    if opts.Title then
        New("TextLabel",{Text=opts.Title,TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(1,0,0,14),TextXAlignment=Enum.TextXAlignment.Left,Parent=vl})
    end
    New("TextLabel",{Text=opts.Text or "",TextSize=10,TextColor3=T.TextDim,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,Parent=vl})
    local api={}; function api:Destroy() row:Destroy() end; return api
end

function Tab:CreateButton(opts)
    opts = opts or {}
    local name = opts.Name or "Button"
    local desc = opts.Description
    local cb   = opts.Callback

    local row = _makeRow(self._list, self._order); self._order=self._order+1
    local btn = New("TextButton",{
        Text=name, TextSize=11, TextColor3=Color3.fromRGB(40,20,5),
        BackgroundColor3=T.Accent, BorderSizePixel=0,
        Font=Enum.Font.GothamBold, Size=UDim2.new(1,0,0,30),
        AutoButtonColor=false, Parent=row,
    })
    Corner(btn,8)
    if desc then AddTooltip(btn, desc) end
    btn.MouseEnter:Connect(function() TweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(200,115,40)}):Play() end)
    btn.MouseLeave:Connect(function() TweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=T.Accent}):Play() end)
    btn.MouseButton1Click:Connect(function() if cb then cb() end end)

    local api={}
    function api:SetName(n) btn.Text=n end
    function api:Destroy() row:Destroy() end
    return api
end

function Tab:CreateToggle(opts)
    opts = opts or {}
    local name    = opts.Name or "Toggle"
    local desc    = opts.Description
    local enabled = opts.CurrentValue or false
    local cb      = opts.Callback
    local flag    = opts.Flag

    local row = _makeRow(self._list, self._order); self._order=self._order+1
    local inner = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
    local vl = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=inner}); VList(vl,2)

    local topRow = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,26),Parent=vl})
    local lbl = New("TextLabel",{Text=name,TextSize=11,TextColor3=T.Text,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,-44,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=topRow})

    local track = New("Frame",{Size=UDim2.new(0,30,0,17),Position=UDim2.new(1,-30,0.5,-8),BackgroundColor3=enabled and T.Accent or T.BG3,BorderSizePixel=0,Parent=topRow})
    Corner(track,9); Stroke(track,enabled and T.AccentDim or T.Border,1)
    local thumb = New("Frame",{Size=UDim2.new(0,11,0,11),Position=enabled and UDim2.new(1,-13,0.5,-5) or UDim2.new(0,3,0.5,-5),BackgroundColor3=T.White,BorderSizePixel=0,Parent=track})
    Corner(thumb,6)

    if desc then
        New("TextLabel",{Text=desc,TextSize=9,TextColor3=T.TextMuted,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,0,12),TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,Parent=vl})
    end

    _divider(self._list, self._order); self._order=self._order+1

    local hit = New("TextButton",{Text="",BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),Parent=topRow})
    hit.MouseButton1Click:Connect(function()
        enabled=not enabled
        local ti=TweenInfo.new(0.12)
        TweenService:Create(track,ti,{BackgroundColor3=enabled and T.Accent or T.BG3}):Play()
        TweenService:Create(thumb,ti,{Position=enabled and UDim2.new(1,-13,0.5,-5) or UDim2.new(0,3,0.5,-5)}):Play()
        if cb then cb(enabled) end
        if flag then Odyssey.Flags[flag]=enabled end
    end)

    local api={}
    function api:Set(o)
        if o.CurrentValue~=nil then
            enabled=o.CurrentValue
            local ti=TweenInfo.new(0.12)
            TweenService:Create(track,ti,{BackgroundColor3=enabled and T.Accent or T.BG3}):Play()
            TweenService:Create(thumb,ti,{Position=enabled and UDim2.new(1,-13,0.5,-5) or UDim2.new(0,3,0.5,-5)}):Play()
        end
    end
    function api:GetValue() return enabled end
    function api:Destroy() row:Destroy() end
    if flag then Odyssey.Flags[flag]=enabled end
    return api
end

function Tab:CreateSlider(opts)
    opts = opts or {}
    local name    = opts.Name or "Slider"
    local range   = opts.Range or {0,100}
    local inc     = opts.Increment or 1
    local defV    = opts.CurrentValue or range[1]
    local cb      = opts.Callback
    local flag    = opts.Flag

    local minV,maxV = range[1],range[2]

    local row = _makeRow(self._list, self._order); self._order=self._order+1
    local inner = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
    local vl = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=inner}); VList(vl,4)

    local topRow = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,16),Parent=vl})
    local lbl = New("TextLabel",{Text=name,TextSize=11,TextColor3=T.Text,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(0.7,0,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=topRow})
    local valLbl = New("TextLabel",{Text=tostring(defV),TextSize=10,TextColor3=T.Accent,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(0.3,0,1,0),TextXAlignment=Enum.TextXAlignment.Right,Parent=topRow})

    local trackF = New("Frame",{Size=UDim2.new(1,0,0,5),BackgroundColor3=T.BG3,BorderSizePixel=0,Parent=vl})
    Corner(trackF,3)
    local pct=(defV-minV)/(maxV-minV)
    local fill = New("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=T.Accent,BorderSizePixel=0,Parent=trackF}); Corner(fill,3)
    local thumbBtn = New("TextButton",{Text="",Size=UDim2.new(0,13,0,13),Position=UDim2.new(pct,-6,0.5,-6),BackgroundColor3=T.Accent,BorderSizePixel=0,AutoButtonColor=false,Parent=trackF})
    Corner(thumbBtn,7)

    _divider(self._list, self._order); self._order=self._order+1

    local dragging=false
    thumbBtn.MouseButton1Down:Connect(function() dragging=true end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
            local rx=i.Position.X-trackF.AbsolutePosition.X
            local p=math.clamp(rx/trackF.AbsoluteSize.X,0,1)
            local raw=minV+p*(maxV-minV)
            local snapped=math.floor(raw/inc+0.5)*inc
            snapped=math.clamp(snapped,minV,maxV)
            valLbl.Text=tostring(snapped)
            fill.Size=UDim2.new(p,0,1,0)
            thumbBtn.Position=UDim2.new(p,-6,0.5,-6)
            if cb then cb(snapped) end
            if flag then Odyssey.Flags[flag]=snapped end
        end
    end)

    local api={}
    function api:Set(o)
        if o.Value then
            local v=math.clamp(o.Value,minV,maxV)
            local p=(v-minV)/(maxV-minV)
            valLbl.Text=tostring(v)
            fill.Size=UDim2.new(p,0,1,0)
            thumbBtn.Position=UDim2.new(p,-6,0.5,-6)
        end
    end
    function api:GetValue() return tonumber(valLbl.Text) end
    function api:Destroy() row:Destroy() end
    if flag then Odyssey.Flags[flag]=defV end
    return api
end

function Tab:CreateInput(opts)
    opts = opts or {}
    local name    = opts.Name or "Input"
    local desc    = opts.Description
    local ph      = opts.PlaceholderText or "Type here..."
    local numeric = opts.Numeric or false
    local maxChar = opts.MaxCharacters
    local enter   = opts.Enter or false
    local cb      = opts.Callback

    local row = _makeRow(self._list, self._order); self._order=self._order+1
    local inner = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
    local vl = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=inner}); VList(vl,4)

    New("TextLabel",{Text=name,TextSize=11,TextColor3=T.Text,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,0,14),TextXAlignment=Enum.TextXAlignment.Left,Parent=vl})
    if desc then New("TextLabel",{Text=desc,TextSize=9,TextColor3=T.TextMuted,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,0,12),TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,Parent=vl}) end

    local tb = New("TextBox",{PlaceholderText=ph,Text="",TextSize=11,TextColor3=T.Text,PlaceholderColor3=T.TextMuted,BackgroundColor3=T.BG3,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,26),TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,Parent=vl})
    Corner(tb,7); Stroke(tb,T.Border,1); Pad(tb,0,8,0,8)
    tb.Focused:Connect(function() Stroke(tb,T.Accent,1) end)
    tb.FocusLost:Connect(function(enterPressed)
        Stroke(tb,T.Border,1)
        local val=tb.Text
        if numeric then val=tonumber(val) or 0; tb.Text=tostring(val) end
        if maxChar and #tb.Text>maxChar then tb.Text=tb.Text:sub(1,maxChar) end
        if enter and not enterPressed then return end
        if cb then cb(val) end
    end)
    tb:GetPropertyChangedSignal("Text"):Connect(function()
        if maxChar and #tb.Text>maxChar then tb.Text=tb.Text:sub(1,maxChar) end
        if numeric then tb.Text=tb.Text:gsub("[^%d%.%-]","") end
        if not enter and cb then cb(tb.Text) end
    end)

    _divider(self._list, self._order); self._order=self._order+1

    local api={}
    function api:Set(o) if o.Value then tb.Text=tostring(o.Value) end end
    function api:GetValue() return tb.Text end
    function api:Destroy() row:Destroy() end
    return api
end

function Tab:CreateDropdown(opts)
    opts = opts or {}
    local name    = opts.Name or "Dropdown"
    local desc    = opts.Description
    local options = opts.Options or {}
    local multi   = opts.MultipleOptions or false
    local special = opts.SpecialType
    local cb      = opts.Callback

    if special=="Player" then
        options={}
        for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
    end

    local selected = multi and (type(opts.CurrentOption)=="table" and opts.CurrentOption or {opts.CurrentOption or options[1]}) or (opts.CurrentOption or options[1] or "")

    local function selText()
        if multi then return type(selected)=="table" and table.concat(selected,", ") or tostring(selected)
        else return tostring(selected) end
    end

    local open = false
    local row = _makeRow(self._list, self._order); self._order=self._order+1
    local inner = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
    local vl = New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=inner}); VList(vl,4)

    if desc then New("TextLabel",{Text=desc,TextSize=9,TextColor3=T.TextMuted,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,0,12),TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,Parent=vl}) end

    local header = New("TextButton",{Text=name.."  |  "..selText(),TextSize=10,TextColor3=T.Text,BackgroundColor3=T.BG3,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,26),TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,Parent=vl})
    Corner(header,7); Stroke(header,T.Border,1); Pad(header,0,8,0,8)
    local arrow=New("TextLabel",{Text="v",TextSize=9,TextColor3=T.TextDim,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(0,16,1,0),Position=UDim2.new(1,-18,0,0),TextXAlignment=Enum.TextXAlignment.Right,Parent=header})

    local body=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=T.BG3,BorderSizePixel=0,Visible=false,Parent=vl})
    Corner(body,7); Stroke(body,T.Border,1); Pad(body,5,5,5,5)
    local bodyVl=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=body}); VList(bodyVl,3)

    local searchBox=New("TextBox",{PlaceholderText="Search...",Text="",TextSize=10,TextColor3=T.Text,PlaceholderColor3=T.TextMuted,BackgroundColor3=T.BG2,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,22),TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,LayoutOrder=0,Parent=bodyVl})
    Corner(searchBox,5); Stroke(searchBox,T.Border,1); Pad(searchBox,0,6,0,6)
    searchBox.Focused:Connect(function() Stroke(searchBox,T.Accent,1) end)
    searchBox.FocusLost:Connect(function() Stroke(searchBox,T.Border,1) end)

    local optFrame=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,LayoutOrder=1,Parent=bodyVl}); VList(optFrame,2)
    local optBtns={}

    local function isSelected(opt)
        if multi then return type(selected)=="table" and table.find(selected,opt) else return selected==opt end
    end

    local function build(list)
        for _,b in ipairs(optBtns) do b:Destroy() end; optBtns={}
        for _,opt in ipairs(list) do
            local sel=isSelected(opt)
            local ob=New("TextButton",{Text=opt,TextSize=10,TextColor3=sel and T.Accent or T.Text,BackgroundColor3=sel and T.BG2 or Color3.new(0,0,0),BackgroundTransparency=sel and 0 or 1,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,22),TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,Parent=optFrame})
            Corner(ob,5); if sel then Stroke(ob,T.Border,1) end; Pad(ob,0,6,0,6)
            ob.MouseButton1Click:Connect(function()
                if multi then
                    if not selected then selected={} end
                    local idx=table.find(selected,opt)
                    if idx then table.remove(selected,idx) else table.insert(selected,opt) end
                else
                    selected=opt; open=false; body.Visible=false; arrow.Text="v"
                end
                header.Text=name.."  |  "..selText()
                build(list)
                if cb then cb(selected) end
            end)
            table.insert(optBtns,ob)
        end
    end
    build(options)

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q=searchBox.Text:lower(); local f={}
        for _,opt in ipairs(options) do if opt:lower():find(q,1,true) then table.insert(f,opt) end end
        build(f)
    end)

    header.MouseButton1Click:Connect(function()
        open=not open; body.Visible=open; arrow.Text=open and "^" or "v"
        if open then searchBox.Text=""; build(options) end
    end)

    if special=="Player" then
        Players.PlayerAdded:Connect(function()
            options={}; for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
            if open then build(options) end
        end)
        Players.PlayerRemoving:Connect(function()
            task.wait(0.1); options={}; for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
            if open then build(options) end
        end)
    end

    _divider(self._list, self._order); self._order=self._order+1

    local api={}
    function api:Set(o)
        if o.Options then options=o.Options; build(options) end

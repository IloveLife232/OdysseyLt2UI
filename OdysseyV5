	local function OdysseyServerHop(direction)
		task.spawn(function()
			win:Notify({Title="Odyssey", Content="Finding a server...", Duration=3})
			local success, result = pcall(function()
				local url = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder="..direction.."&limit=100"
				local response = game:HttpGet(url)
				return game:GetService("HttpService"):JSONDecode(response)
			end)

			if not success or not result or not result.data then
				win:Notify({Title="Odyssey", Content="Failed to fetch server list", Duration=3})
				return
			end

			local currentJobId = game.JobId
			for _, server in ipairs(result.data) do
				if server.id ~= currentJobId and server.playing < server.maxPlayers then
					game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, server.id, Players.LocalPlayer)
					return
				end
			end
			win:Notify({Title="Odyssey", Content="No available server found", Duration=3})
		end)
	end


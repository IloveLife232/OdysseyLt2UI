-- Toggle switch
local function AddToggle(labelTxt, on, parent, order, tip)
    local row=New("Frame",{Size=UDim2.new(1,0,0,24),BackgroundTransparency=1,LayoutOrder=order or 0,Parent=parent})
    local lbl=Lbl(labelTxt,11,T.Text); lbl.Size=UDim2.new(1,-38,1,0); lbl.Parent=row
    local enabled=on or false
    local track=New("Frame",{Size=UDim2.new(0,28,0,16),Position=UDim2.new(1,-28,0.5,-8),BackgroundColor3=enabled and T.Accent or T.BG3,BorderSizePixel=0,Parent=row})
    Corner(track,8); Stroke(track,enabled and T.AccentDim or T.Border,1)
    local thumb=New("Frame",{Size=UDim2.new(0,10,0,10),Position=enabled and UDim2.new(1,-12,0.5,-5) or UDim2.new(0,2,0.5,-5),BackgroundColor3=T.White,BorderSizePixel=0,Parent=track})
    Corner(thumb,5)
    local hit=Btn("",0,T.Text,Color3.new(0,0,0)); hit.BackgroundTransparency=1; hit.Size=UDim2.new(1,0,1,0); hit.Parent=row
    if tip then AddTooltip(row,tip) end
    hit.MouseButton1Click:Connect(function()
        enabled=not enabled
        local ti=TweenInfo.new(0.12)
        TweenService:Create(track,ti,{BackgroundColor3=enabled and T.Accent or T.BG3}):Play()
        TweenService:Create(thumb,ti,{Position=enabled and UDim2.new(1,-12,0.5,-5) or UDim2.new(0,2,0.5,-5)}):Play()
    end)
    New("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,1,0),BackgroundColor3=T.Border,BorderSizePixel=0,Parent=row})
    return row
end

-- Slider
local function AddSlider(labelTxt, minV, maxV, defV, parent, order, tip)
    local row=New("Frame",{Size=UDim2.new(1,0,0,36),BackgroundTransparency=1,LayoutOrder=order or 0,Parent=parent})
    local lbl=Lbl(labelTxt,11,T.Text); lbl.Size=UDim2.new(0.7,0,0,14); lbl.Parent=row
    local valLbl=Lbl(tostring(defV),10,T.Accent,Enum.Font.Gotham,Enum.TextXAlignment.Right); valLbl.Size=UDim2.new(0.3,0,0,14); valLbl.Parent=row
    local track=New("Frame",{Size=UDim2.new(1,0,0,4),Position=UDim2.new(0,0,0,20),BackgroundColor3=T.BG3,BorderSizePixel=0,Parent=row})
    Corner(track,2)
    local pct=(defV-minV)/(maxV-minV)
    local fill=New("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=T.Accent,BorderSizePixel=0,Parent=track}); Corner(fill,2)
    local thumb=Btn("",0,T.Text,T.Accent); thumb.Size=UDim2.new(0,12,0,12); thumb.Position=UDim2.new(pct,-6,0.5,-6); thumb.BorderSizePixel=0; thumb.Parent=track; Corner(thumb,6)
    if tip then AddTooltip(row,tip) end
    local dragging=false
    thumb.MouseButton1Down:Connect(function() dragging=true end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
            local rx=i.Position.X-track.AbsolutePosition.X
            local p2=math.clamp(rx/track.AbsoluteSize.X,0,1)
            local v=math.floor(minV+p2*(maxV-minV))
            valLbl.Text=tostring(v); fill.Size=UDim2.new(p2,0,1,0); thumb.Position=UDim2.new(p2,-6,0.5,-6)
        end
    end)
    return row
end

-- Button
local function AddButton(txt, parent, order, col, bgcol, tip)
    local b=Btn(txt,10,col or T.Text,bgcol or T.BG3)
    b.Size=UDim2.new(1,0,0,26); b.LayoutOrder=order or 0; b.Parent=parent
    Corner(b,7); Stroke(b,T.Border,1)
    if tip then AddTooltip(b,tip) end
    b.MouseEnter:Connect(function() TweenService:Create(b,TweenInfo.new(0.1),{BackgroundColor3=T.BG2}):Play() end)
    b.MouseLeave:Connect(function() TweenService:Create(b,TweenInfo.new(0.1),{BackgroundColor3=bgcol or T.BG3}):Play() end)
    return b
end


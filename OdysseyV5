    -- Track with glass style when off, accent when on
    local track=New("Frame",{Size=UDim2.new(0,32,0,18),Position=UDim2.new(1,-32,0.5,-9),BackgroundColor3=enabled and T.Accent or Color3.fromRGB(255,255,255),BackgroundTransparency=enabled and 0 or 0.88,BorderSizePixel=0,Parent=topRow})
    Corner(track,9); GlassStroke(track,enabled and 1 or 0.75)

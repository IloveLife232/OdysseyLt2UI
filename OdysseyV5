				if cb then cb() end
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if hold and i.KeyCode.Name==current and holdActive then
			holdActive=false
			if cb then cb(false) end
		end
	end)
	reg(self,opts.Name,card)
	local api={}
	function api:Set(o) if o.KeyCode then current=o.KeyCode.Name; keyBtn.Text=current end end
	function api:GetValue() return current end
	function api:Destroy() card:Destroy() end
	return api

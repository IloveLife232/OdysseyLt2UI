function Tab:CreateInput(opts)
	opts=opts or {}
	local cb=opts.Callback
	local enter=opts.Enter or false
	local row=_row(self._list,self._order); self._order=self._order+1
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
	VList(vl,4)
	local nameRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,14),Parent=vl})
	New("TextLabel",{Text=opts.Name or "Input",TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamMedium,BackgroundTransparency=1,Size=UDim2.new(1,-20,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=nameRow})
	local infoText=opts.Description or opts.Tooltip
	if infoText then AddTooltip(nameRow,infoText,true,nameRow,UDim2.new(1,-16,0.5,-7)) end
	local tb=New("TextBox",{PlaceholderText=opts.PlaceholderText or "Type here...",Text="",TextSize=11,TextColor3=T.Text,PlaceholderColor3=T.TextMuted,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,28),TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,Parent=vl})
	Corner(tb,8); GlassStroke(tb,0.65); Pad(tb,0,8,0,8)
	tb.Focused:Connect(function() Stroke(tb,Color3.fromRGB(255,255,255),1,0.2) end)
	tb.FocusLost:Connect(function(ep)
		GlassStroke(tb,0.65)
		if opts.Numeric then tb.Text=tostring(tonumber(tb.Text) or 0) end
		if opts.MaxCharacters and #tb.Text>opts.MaxCharacters then tb.Text=tb.Text:sub(1,opts.MaxCharacters) end
		if enter and not ep then return end
		if cb then cb(tb.Text) end
	end)
	tb:GetPropertyChangedSignal("Text"):Connect(function()
		if opts.MaxCharacters and #tb.Text>opts.MaxCharacters then tb.Text=tb.Text:sub(1,opts.MaxCharacters) end
		if opts.Numeric then tb.Text=tb.Text:gsub("[^%d%.%-]","") end
		if not enter and cb then cb(tb.Text) end
	end)
	_div(self._list,self._order); self._order=self._order+1
	local api={}
	function api:Set(o) if o.Value then tb.Text=tostring(o.Value) end end
	function api:GetValue() return tb.Text end
	function api:Destroy() row:Destroy() end
	return api
end

-- A textbox and a small dropdown side-by-side in one row, instead of each
-- taking a full row on their own. Useful for name+category style pairs.
function Tab:CreateInputWithDropdown(opts)
	opts=opts or {}
	local textCb=opts.TextCallback
	local dropCb=opts.DropdownCallback
	local enter=opts.Enter or false
	local ddOptions=opts.DropdownOptions or {}
	local ddCurrent=opts.DropdownCurrentOption or ddOptions[1] or ""
	local row=_row(self._list,self._order); self._order=self._order+1
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
	VList(vl,4)
	local nameRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,14),Parent=vl})
	New("TextLabel",{Text=opts.Name or "Input",TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamMedium,BackgroundTransparency=1,Size=UDim2.new(1,-20,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=nameRow})
	local infoText=opts.Description or opts.Tooltip
	if infoText then AddTooltip(nameRow,infoText,true,nameRow,UDim2.new(1,-16,0.5,-7)) end

	local pairRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,28),Parent=vl})
	local HList2=Instance.new("UIListLayout")
	HList2.FillDirection=Enum.FillDirection.Horizontal
	HList2.Padding=UDim.new(0,6)
	HList2.VerticalAlignment=Enum.VerticalAlignment.Center
	HList2.Parent=pairRow

	local tb=New("TextBox",{PlaceholderText=opts.PlaceholderText or "Type here...",Text="",TextSize=11,TextColor3=T.Text,PlaceholderColor3=T.TextMuted,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(0.62,0,1,0),TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,LayoutOrder=1,Parent=pairRow})
	Corner(tb,8); GlassStroke(tb,0.65); Pad(tb,0,8,0,8)
	tb.Focused:Connect(function() Stroke(tb,Color3.fromRGB(255,255,255),1,0.2) end)
	tb.FocusLost:Connect(function(ep)
		GlassStroke(tb,0.65)
		if enter and not ep then return end
		if textCb then textCb(tb.Text) end
	end)
	tb:GetPropertyChangedSignal("Text"):Connect(function()
		if not enter and textCb then textCb(tb.Text) end
	end)

	-- Small dropdown, compact width, dropdown body opens below the whole row
	local ddSelected=ddCurrent
	local ddOpen=false
	local ddWrap=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(0.35,0,1,0),LayoutOrder=2,Parent=pairRow})
	local ddHeader=New("TextButton",{Text=tostring(ddSelected),TextSize=10,TextColor3=T.Text,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,1,0),TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,Parent=ddWrap})
	Corner(ddHeader,8); GlassStroke(ddHeader,0.65); Pad(ddHeader,0,6,0,16)
	local ddArrow=New("TextLabel",{Text="v",TextSize=9,TextColor3=T.TextDim,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(0,14,1,0),Position=UDim2.new(1,-15,0,0),TextXAlignment=Enum.TextXAlignment.Center,Parent=ddHeader})
	local ddBody=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,Visible=false,LayoutOrder=3,Parent=vl})
	Corner(ddBody,10); GlassStroke(ddBody,0.65); Pad(ddBody,5,5,5,5)
	local ddList=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=ddBody})
	VList(ddList,3)
	local ddBtns={}
	local function ddBuild()
		for _,b in ipairs(ddBtns) do b:Destroy() end
		ddBtns={}
		for _,opt in ipairs(ddOptions) do
			local sel=(ddSelected==opt)
			local ob=New("TextButton",{Text=opt,TextSize=10,TextColor3=T.Text,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=sel and 0.8 or 1,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,22),TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,Parent=ddList})
			Corner(ob,6); Pad(ob,0,6,0,6)
			ob.MouseButton1Click:Connect(function()
				ddSelected=opt
				ddHeader.Text=tostring(ddSelected)
				ddOpen=false; ddBody.Visible=false; ddArrow.Text="v"
				ddBuild()
				if dropCb then dropCb(ddSelected) end
			end)
			table.insert(ddBtns,ob)
		end
	end
	ddBuild()
	ddHeader.MouseButton1Click:Connect(function()
		ddOpen=not ddOpen
		ddBody.Visible=ddOpen
		ddArrow.Text=ddOpen and "^" or "v"
	end)

	_div(self._list,self._order); self._order=self._order+1
	local api={}
	function api:SetText(v) tb.Text=tostring(v) end
	function api:GetText() return tb.Text end
	function api:SetDropdown(v) ddSelected=v; ddHeader.Text=tostring(v); ddBuild() end
	function api:GetDropdown() return ddSelected end
	function api:Destroy() row:Destroy() end
	return api
end

function Tab:CreateDropdown(opts)
	opts=opts or {}
	local options=opts.Options or {}
	local multi=opts.MultipleOptions or false
	local cb=opts.Callback
	local special=opts.SpecialType
	if special=="Player" then
		options={}
		for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
	end
	local selected=multi and (type(opts.CurrentOption)=="table" and opts.CurrentOption or {opts.CurrentOption or options[1]}) or (opts.CurrentOption or options[1] or "")
	local function selText() return multi and (type(selected)=="table" and table.concat(selected,", ") or tostring(selected)) or tostring(selected) end
	local open=false
	local row=_row(self._list,self._order); self._order=self._order+1
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
	VList(vl,4)
	local nameRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,14),Parent=vl})
	New("TextLabel",{Text=opts.Name or "Dropdown",TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamMedium,BackgroundTransparency=1,Size=UDim2.new(1,-20,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=nameRow})
	local infoText=opts.Description or opts.Tooltip
	if infoText then AddTooltip(nameRow,infoText,true,nameRow,UDim2.new(1,-16,0.5,-7)) end
	local header=New("TextButton",{Text=selText(),TextSize=10,TextColor3=T.Text,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,28),TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,Parent=vl})
	Corner(header,8); GlassStroke(header,0.65); Pad(header,0,28,0,8)
	local arrow=New("TextLabel",{Text="v",TextSize=10,TextColor3=T.TextDim,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(0,18,1,0),Position=UDim2.new(1,-20,0,0),TextXAlignment=Enum.TextXAlignment.Center,Parent=header})
	local body=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,Visible=false,Parent=vl})
	Corner(body,10); GlassStroke(body,0.65); Pad(body,5,5,5,5)
	local bvl=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=body})
	VList(bvl,3)
	local sb=New("TextBox",{PlaceholderText="Search...",Text="",TextSize=10,TextColor3=T.Text,PlaceholderColor3=T.TextMuted,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.88,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,24),TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,LayoutOrder=0,Parent=bvl})
	Corner(sb,6); GlassStroke(sb,0.6); Pad(sb,0,6,0,6)
	local optF=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,LayoutOrder=1,Parent=bvl})
	VList(optF,2)
	local optBtns={}
	local function isSel(o) return multi and type(selected)=="table" and table.find(selected,o) or selected==o end
	local function build(list)
		for _,b in ipairs(optBtns) do b:Destroy() end
		optBtns={}
		for _,opt in ipairs(list) do
			local s=isSel(opt)
			local ob=New("TextButton",{Text=opt,TextSize=10,TextColor3=T.Text,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=s and 0.8 or 1,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,24),TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,Parent=optF})
			Corner(ob,6); Pad(ob,0,6,0,6)
			ob.MouseButton1Click:Connect(function()
				if multi then
					if not selected then selected={} end
					local idx=table.find(selected,opt)
					if idx then table.remove(selected,idx) else table.insert(selected,opt) end
				else
					selected=opt; open=false; body.Visible=false; arrow.Text="v"
				end
				header.Text=selText()
				build(list)
				if cb then cb(selected) end
			end)
			table.insert(optBtns,ob)
		end
	end
	build(options)
	sb:GetPropertyChangedSignal("Text"):Connect(function()
		local q=sb.Text:lower()
		local f={}
		for _,o in ipairs(options) do if o:lower():find(q,1,true) then table.insert(f,o) end end
		build(f)
	end)
	header.MouseButton1Click:Connect(function()
		open=not open
		body.Visible=open
		arrow.Text=open and "^" or "v"
		if open then sb.Text=""; build(options) end
	end)
	if special=="Player" then
		Players.PlayerAdded:Connect(function()
			options={}
			for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
			if open then build(options) end
		end)
		Players.PlayerRemoving:Connect(function()
			task.wait(0.1)
			options={}
			for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
			if open then build(options) end
		end)
	end
	_div(self._list,self._order); self._order=self._order+1
	local api={}
	function api:Set(o)
		if o.Options then options=o.Options; build(options) end
		if o.CurrentOption~=nil then selected=o.CurrentOption; header.Text=selText(); build(options) end
	end
	function api:GetValue() return selected end
	function api:Destroy() row:Destroy() end
	return api
end


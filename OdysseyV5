			currentLT2BG=Color3.fromRGB(20,110,200)
		elseif themeName=="Forest" then
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(20,120,40)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(50,180,80)),ColorSequenceKeypoint.new(1,Color3.fromRGB(15,150,110))})
			currentLT2BG=Color3.fromRGB(30,150,70)
		elseif themeName=="Cosmic" then
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(80,30,190)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(140,50,230)),ColorSequenceKeypoint.new(1,Color3.fromRGB(40,110,255))})
			currentLT2BG=Color3.fromRGB(100,50,220)
		elseif themeName=="Blossom" then
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,92,160)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(200,80,220)),ColorSequenceKeypoint.new(1,Color3.fromRGB(122,60,240))})
			currentLT2BG=Color3.fromRGB(180,70,200)
		elseif themeName=="Crimson" then
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(140,10,30)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(200,20,80)),ColorSequenceKeypoint.new(1,Color3.fromRGB(160,30,160))})
			currentLT2BG=Color3.fromRGB(170,25,90)
		elseif themeName=="Gold" then
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,210,60)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(255,160,32)),ColorSequenceKeypoint.new(1,Color3.fromRGB(232,100,30))})
			currentLT2BG=Color3.fromRGB(240,150,40)
		elseif themeName=="Slate" then
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(74,108,174)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(90,90,140)),ColorSequenceKeypoint.new(1,Color3.fromRGB(50,50,78))})
			currentLT2BG=Color3.fromRGB(70,90,130)
		elseif themeName=="Mint" then
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(40,210,150)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(30,180,200)),ColorSequenceKeypoint.new(1,Color3.fromRGB(60,150,230))})
			currentLT2BG=Color3.fromRGB(35,190,180)
		elseif themeName=="Citrus" then
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(240,230,20)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(240,90,60)),ColorSequenceKeypoint.new(1,Color3.fromRGB(230,20,110))})
			currentLT2BG=Color3.fromRGB(240,110,70)
		elseif themeName=="Electric" then
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(0,210,255)),ColorSequenceKeypoint.new(0.5,Color3.fromRGB(58,92,255)),ColorSequenceKeypoint.new(1,Color3.fromRGB(138,30,255))})
			currentLT2BG=Color3.fromRGB(48,110,255)
		else
			-- Custom theme fallback: look up from Themes table
			local t=Themes[themeName]
			if not t then return end
			seq=ColorSequence.new({ColorSequenceKeypoint.new(0,t.c1),ColorSequenceKeypoint.new(0.5,t.c2),ColorSequenceKeypoint.new(1,t.c3)})
			currentLT2BG=t.LT2BG or t.c2
			if t.accent then T.Accent=t.accent; T.AccentHov=t.accent end
		end

		currentThemeColors={c1=seq.Keypoints[1].Value,c2=seq.Keypoints[2].Value,c3=seq.Keypoints[3].Value}
		if OdysseyMainRef then
			pcall(function()
				-- Set solid background color FIRST as a guaranteed-visible base color
				OdysseyMainRef.BackgroundColor3=seq.Keypoints[2].Value
				-- Then layer the gradient on top for the multi-color effect
				for _,old in ipairs(OdysseyMainRef:GetChildren()) do
					if old:IsA("UIGradient") then old:Destroy() end
				end
				local grad=Instance.new("UIGradient")
				grad.Color=seq
				grad.Rotation=120
				grad.Parent=OdysseyMainRef
				OdysseyGradient=grad
			end)
		end
		-- Keep every progress bar's fill in sync with the new theme
		for grad,_ in pairs(ProgressBarGradients) do
			pcall(function()
				if grad and grad.Parent then grad.Color=seq end
			end)
		end
		ApplyLT2Theme(currentLT2BG)
	end

	local themeNames={"Blossom","Citrus","Cosmic","Crimson","Electric","Forest","Gold","Mint","Ocean","Slate"}
	local themeDD=settingsTab:CreateDropdown({
		Name="UI Theme",
		Options=themeNames,
		CurrentOption="Slate",
		Tooltip="Change the gradient theme",
		Callback=function(v)
			ApplyThemeDirect(v)
			Odyssey.Flags["OdysseyTheme"]=v
		end,
	})

	settingsTab:CreateToggle({
		Name="LT2 theme",
		Description="Apply theme colors to LT2 game menus",
		CurrentValue=true,
		Tooltip="Toggle LT2 menu recolor",
		Callback=function(v)
			lt2ThemeEnabled=v
			if v then
				task.spawn(function() ApplyLT2Theme(currentLT2BG) end)
			else
				task.spawn(function() RevertLT2Theme() end)
			end
		end,
	})

	-- ===== CUSTOM THEME CREATOR (same THEME section, no separate header) =====
	local CUSTOM_THEME_FOLDER="Odyssey/OdysseyConfigs/CustomThemes"
	local function ensureCustomThemeFolder()
		pcall(function()
			if not isfolder("Odyssey") then makefolder("Odyssey") end
			if not isfolder("Odyssey/OdysseyConfigs") then makefolder("Odyssey/OdysseyConfigs") end
			if not isfolder(CUSTOM_THEME_FOLDER) then makefolder(CUSTOM_THEME_FOLDER) end
		end)
	end

	local customC1=Color3.fromRGB(255,255,255)
	local customC2=Color3.fromRGB(180,180,180)
	local customC3=Color3.fromRGB(100,100,100)
	local customAccent=Color3.fromRGB(255,255,255)
	local customNameValue="MyTheme"

	settingsTab:CreateInput({
		Name="Theme name",
		PlaceholderText="Enter a name...",
		Callback=function(v) if v~="" then customNameValue=v end end,
	})

	local function ApplyCustomPreview()
		local newSeq=ColorSequence.new({
			ColorSequenceKeypoint.new(0,customC1),
			ColorSequenceKeypoint.new(0.5,customC2),
			ColorSequenceKeypoint.new(1,customC3),
		})
		if OdysseyMainRef then
			pcall(function()
				OdysseyMainRef.BackgroundColor3=newSeq.Keypoints[2].Value
				for _,old in ipairs(OdysseyMainRef:GetChildren()) do
					if old:IsA("UIGradient") then old:Destroy() end
				end
				local grad=Instance.new("UIGradient")
				grad.Color=newSeq
				grad.Rotation=120
				grad.Parent=OdysseyMainRef
				OdysseyGradient=grad
			end)
		end
		T.Accent=customAccent
		T.AccentHov=customAccent
		currentThemeColors={c1=customC1,c2=customC2,c3=customC3}
		for g,_ in pairs(ProgressBarGradients) do pcall(function() if g and g.Parent then g.Color=newSeq end end) end
		-- Keep LT2 menus in sync with the live preview too, not just the UI itself
		currentLT2BG=customC2
		if lt2ThemeEnabled then
			task.spawn(function() ApplyLT2Theme(currentLT2BG) end)
		end
	end

	settingsTab:CreateColorPicker({
		Name="Gradient Start",
		Color=customC1,
		Callback=function(v) customC1=v; ApplyCustomPreview() end,
	})
	settingsTab:CreateColorPicker({
		Name="Gradient Middle",
		Color=customC2,
		Callback=function(v) customC2=v; ApplyCustomPreview() end,
	})
	settingsTab:CreateColorPicker({
		Name="Gradient End",
		Color=customC3,
		Callback=function(v) customC3=v; ApplyCustomPreview() end,
	})
	settingsTab:CreateColorPicker({
		Name="Accent Color",
		Color=customAccent,
		Tooltip="Controls buttons, sliders, toggles and text highlights",
		Callback=function(v) customAccent=v; ApplyCustomPreview() end,
	})

	settingsTab:CreateInput({
		Name="Theme Code",
		PlaceholderText='{"c1":[R,G,B],"c2":[R,G,B],"c3":[R,G,B],"accent":[R,G,B]}',
		Enter=true,
		Description="Paste exported theme JSON here to test/load it directly",
		Callback=function(v)
			local ok,data=pcall(function() return game:GetService("HttpService"):JSONDecode(v) end)
			if not ok or not data or not data.c1 or not data.c2 or not data.c3 then
				Window:Notify({Title="Odyssey", Content="Invalid theme code", Duration=3})
				return
			end
			customC1=Color3.fromRGB(data.c1[1],data.c1[2],data.c1[3])
			customC2=Color3.fromRGB(data.c2[1],data.c2[2],data.c2[3])
			customC3=Color3.fromRGB(data.c3[1],data.c3[2],data.c3[3])
			customAccent=data.accent and Color3.fromRGB(data.accent[1],data.accent[2],data.accent[3]) or customC2
			ApplyCustomPreview()
			Window:Notify({Title="Odyssey", Content="Theme code loaded! Save it below to keep it", Duration=4})
		end,
	})

	local function saveCustomTheme(themeName,c1,c2,c3,accent)
		pcall(function()
			ensureCustomThemeFolder()
			local data={
				c1={c1.R*255,c1.G*255,c1.B*255},
				c2={c2.R*255,c2.G*255,c2.B*255},
				c3={c3.R*255,c3.G*255,c3.B*255},
				accent={accent.R*255,accent.G*255,accent.B*255},
			}
			writefile(CUSTOM_THEME_FOLDER.."/"..themeName..".json",game:GetService("HttpService"):JSONEncode(data))
		end)
	end

	local function loadCustomThemesFromFolder()
		pcall(function()
			ensureCustomThemeFolder()
			for _,fname in ipairs(listfiles(CUSTOM_THEME_FOLDER)) do
				local themeName=fname:match("([^/\\]+)%.json$")
				if themeName and not Themes[themeName] then
					local ok,data=pcall(function() return game:GetService("HttpService"):JSONDecode(readfile(fname)) end)
					if ok and data and data.c1 and data.c2 and data.c3 then
						local accentCol = data.accent and Color3.fromRGB(data.accent[1],data.accent[2],data.accent[3]) or Color3.fromRGB(data.c2[1],data.c2[2],data.c2[3])
						Themes[themeName]={
							c1=Color3.fromRGB(data.c1[1],data.c1[2],data.c1[3]),
							c2=Color3.fromRGB(data.c2[1],data.c2[2],data.c2[3]),
							c3=Color3.fromRGB(data.c3[1],data.c3[2],data.c3[3]),
							LT2BG=Color3.fromRGB(data.c2[1],data.c2[2],data.c2[3]),
							accent=accentCol,
						}
						table.insert(themeNames,themeName)
						table.sort(themeNames)
					end
				end
			end
		end)
	end

	settingsTab:CreateButton({
		Name="Save custom theme",
		Description="Saves your custom colors as a new theme and adds it to the dropdown above",
		Tooltip="Adds your 3 chosen colors as a new selectable theme",
		Callback=function()
			if customNameValue=="" then return end
			Themes[customNameValue]={c1=customC1,c2=customC2,c3=customC3,LT2BG=customC2,accent=customAccent}
			saveCustomTheme(customNameValue,customC1,customC2,customC3,customAccent)
			table.insert(themeNames,customNameValue)
			table.sort(themeNames)
			themeDD:Set({Options=themeNames})
			win:Notify({Title="Custom Theme",Content="\""..customNameValue.."\" saved and added!",Duration=3})
		end,
	})

	settingsTab:CreateButton({
		Name="Copy custom theme code",
		Description="Copies a Lua table snippet of your current custom colors to your clipboard",
		Tooltip="Paste this into the theme table to share or reuse it",
		Callback=function()
			local function toRGB(c) return math.floor(c.R*255)..","..math.floor(c.G*255)..","..math.floor(c.B*255) end
			local code = "[\""..customNameValue.."\"]={c1=Color3.fromRGB("..toRGB(customC1)..
				"),c2=Color3.fromRGB("..toRGB(customC2)..
				"),c3=Color3.fromRGB("..toRGB(customC3)..
				"),LT2BG=Color3.fromRGB("..toRGB(customC2)..
				"),accent=Color3.fromRGB("..toRGB(customAccent).."),},"
			pcall(function() setclipboard(code) end)
			win:Notify({Title="Copied",Content="Custom theme code copied to clipboard!",Duration=3})
		end,
	})

	loadCustomThemesFromFolder()
	if #themeNames>10 then themeDD:Set({Options=themeNames}) end

	settingsTab:CreateSection("CONFIG")
	local pathRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,24),LayoutOrder=settingsTab._order,Parent=settingsTab._list})
	settingsTab._order=settingsTab._order+1
	local pathBox=New("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=C.Field,BackgroundTransparency=0,BorderSizePixel=0,Parent=pathRow})
	Corner(pathBox,7); GlassStroke(pathBox,0.65); Pad(pathBox,0,8,0,8)
	New("TextLabel",{Text="Odyssey/",TextSize=12,TextColor3=T.Blue,Font=Enum.Font.Code,BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=pathBox})
	AddTooltip(pathBox,"Root folder for all Odyssey data",true,pathBox)
	settingsTab:CreateToggle({
		Name="Load config on join",
		CurrentValue=true,
		Description="Loads saved settings on join",
		Tooltip="Toggle auto load",
		Callback=function(v) _G.OdysseyAutoLoad=v end,
	})

	local CONFIG_PATH="Odyssey/OdysseyConfigs/config.json"
	local FOLDERS={"Odyssey","Odyssey/OdysseyBuilds","Odyssey/OdysseyConfigs","Odyssey/OdysseyConfigs/CustomThemes","Odyssey/OdysseySlotNames"}
	local function ensureFolders() pcall(function() for _,f in ipairs(FOLDERS) do if not isfolder(f) then makefolder(f) end end end) end
	local function saveConfig()
		pcall(function()
			ensureFolders()
			local data={}
			for k,v in pairs(Odyssey.Flags) do
				local t=type(v)
				if t=="boolean" or t=="number" or t=="string" then data[k]=v end
			end
			writefile(CONFIG_PATH,game:GetService("HttpService"):JSONEncode(data))
		end)
	end
	local function loadConfig()
		pcall(function()
			if isfile(CONFIG_PATH) then
				local data=game:GetService("HttpService"):JSONDecode(readfile(CONFIG_PATH))
				for k,v in pairs(data) do Odyssey.Flags[k]=v end
			end
		end)
	end
	if _G.OdysseyAutoLoad~=false then
		task.defer(function()
			loadConfig()
			local savedTheme=Odyssey.Flags["OdysseyTheme"]
			if savedTheme and Themes[savedTheme] then
				ApplyThemeDirect(savedTheme)
				themeDD:Set({CurrentOption=savedTheme})
			end
			local savedLayout=Odyssey.Flags["OdysseyLayout"]
			if savedLayout=="Sidebar" or savedLayout=="Compact" then ApplyLayout(savedLayout) end
		end)
	end

	local cfgBtnRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,LayoutOrder=settingsTab._order,Parent=settingsTab._list})
	settingsTab._order=settingsTab._order+1
	local cfgGrid=Instance.new("UIGridLayout")
	cfgGrid.CellSize=UDim2.new(0.5,-4,0,28)
	cfgGrid.CellPadding=UDim2.new(0,8,0,6)
	cfgGrid.Parent=cfgBtnRow
	local function makeConfigBtn(txt,tip,cb2)
		local b=New("TextButton",{Text=txt,TextSize=12,TextColor3=T.Text,BackgroundColor3=C.Field,BackgroundTransparency=0,BorderSizePixel=0,Font=Enum.Font.BuilderSansMedium,AutoButtonColor=false,Parent=cfgBtnRow})
		Corner(b,8); GlassStroke(b,0.65); AddTooltip(b,tip,true,b)
		b.MouseButton1Click:Connect(function() if cb2 then cb2() end end)
		return b
	end
	makeConfigBtn("Save config","Save all settings to file",function() saveConfig(); win:Notify({Title="Config",Content="Config saved!",Duration=3}) end)
	makeConfigBtn("Delete config","Permanently delete saved config",function() pcall(function() if isfile(CONFIG_PATH) then delfile(CONFIG_PATH) end end); win:Notify({Title="Config",Content="Config deleted",Duration=3}) end)

	settingsTab:CreateSection("CREDITS")
	settingsTab:CreateParagraph({Title="Odyssey UI",Text="Script by: IHateSchool & Vaxeal\nUI Library: Odyssey Lib v6\nTesters: Nazab, Pete <3 & Gludgy"})

	function win:Notify(nopts2) Window.Notify(self,nopts2) end
	function win:SetKeybind(key) toggleKey=key end
	function win:CreateUpdateLog(opts2) Window.CreateUpdateLog(self,opts2) end
	function win:CreateDonationPanel(opts2) Window.CreateDonationPanel(self,opts2) end
	function win:CreateDiscordButton(opts2) Window.CreateDiscordButton(self,opts2) end
	function win:CreateTab(opts2) return Window.CreateTab(self,opts2) end

	return win
end

return Odyssey

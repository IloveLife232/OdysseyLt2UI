-- Reload slot cooldown from NoticeGUI
pcall(function()
    local noticeGUI=PlayerGui:WaitForChild("NoticeGUI",10)
    local noticeOpen=noticeGUI:WaitForChild("NoticeOpen",5)
    local noticeText=noticeGUI.Notice.Main.TextLabel
    local slotCooldown=0
    local slotActive=false

    local function checkNotice()
        local text=noticeText.Text
        if text:find("load again") then
            local seconds=text:match("Wait (%d+) seconds")
            if seconds then
                slotCooldown=tonumber(seconds)
                slotActive=true
                slotTimer.TextColor3=T.Accent
            end
        end
    end

    noticeOpen.Changed:Connect(function(v) if v then checkNotice() end end)
    noticeText:GetPropertyChangedSignal("Text"):Connect(function()
        if noticeOpen.Value then checkNotice() end
    end)

    RunService.Heartbeat:Connect(function()
        if slotActive and slotCooldown > 0 then
            slotCooldown=slotCooldown-0.016
            slotTimer.Text=formatTime(math.max(0,math.ceil(slotCooldown)))
            if slotCooldown<=0 then
                slotActive=false
                slotTimer.Text="Ready"
                slotTimer.TextColor3=T.Green
            end
        end
    end)
end)


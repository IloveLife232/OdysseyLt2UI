Pages={}
NavBtns={}

function SetPage(id)
    for _,nb in ipairs(NavBtns) do
        nb.btn.BackgroundTransparency=1
        nb.btn.TextColor3=T.TextDim
        nb.bar.Visible=false
        if Pages[nb.id] then Pages[nb.id].Visible=false end
    end
    for _,nb in ipairs(NavBtns) do
        if nb.id==id then
            nb.btn.BackgroundTransparency=0
            nb.btn.BackgroundColor3=T.BG2
            nb.btn.TextColor3=T.Text
            nb.bar.Visible=true
        end
    end
    if Pages[id] then Pages[id].Visible=true end
end

function AddTab(label, id, order, disabled)
    local btn=Btn(label,10,disabled and T.TextMuted or T.TextDim,Color3.new(0,0,0),Enum.Font.GothamBold)
    btn.BackgroundTransparency=1
    btn.Size=UDim2.new(1,0,0,30)
    btn.LayoutOrder=order or #NavBtns+1
    btn.AutoButtonColor=false
    btn.Parent=SideList
    Corner(btn,7)
    local bar=New("Frame",{
        Size=UDim2.new(0,2,0,16),Position=UDim2.new(0,-2,0.5,-8),
        BackgroundColor3=T.Accent,BorderSizePixel=0,Visible=false,Parent=btn,
    })
    Corner(bar,1)
    local page=New("Frame",{
        Name="P_"..id,Size=UDim2.new(1,0,0,0),
        AutomaticSize=Enum.AutomaticSize.Y,
        BackgroundTransparency=1,Visible=false,Parent=ContentScroll,
    })
    VList(page,7)
    Pages[id]=page
    if not disabled then
        table.insert(NavBtns,{btn=btn,bar=bar,id=id})
        btn.MouseButton1Click:Connect(function() SetPage(id) end)
    end
    return page
end


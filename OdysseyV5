-- Color picker
local function AddColorPicker(labelTxt, defaultColor, parent, order, tip)
    local row=New("Frame",{Size=UDim2.new(1,0,0,28),BackgroundTransparency=1,LayoutOrder=order or 0,Parent=parent})
    local lbl=Lbl(labelTxt,11,T.Text); lbl.Size=UDim2.new(1,-80,1,0); lbl.Parent=row
    local preview=New("Frame",{Size=UDim2.new(0,22,0,22),Position=UDim2.new(1,-72,0.5,-11),BackgroundColor3=defaultColor or T.Accent,BorderSizePixel=0,Parent=row})
    Corner(preview,5); Stroke(preview,T.Border,1)
    local hexBox=New("TextBox",{
        Text="",PlaceholderText="#E07A1F",TextSize=10,TextColor3=T.Text,PlaceholderColor3=T.TextMuted,
        BackgroundColor3=T.BG3,BorderSizePixel=0,Font=Enum.Font.Code,
        Size=UDim2.new(0,46,0,22),Position=UDim2.new(1,-48,0.5,-11),
        TextXAlignment=Enum.TextXAlignment.Center,ClearTextOnFocus=false,Parent=row,
    })
    Corner(hexBox,5); Stroke(hexBox,T.Border,1)
    if tip then AddTooltip(row,tip) end
    hexBox.Focused:Connect(function() Stroke(hexBox,T.Accent,1) end)
    hexBox.FocusLost:Connect(function()
        Stroke(hexBox,T.Border,1)
        local hex=hexBox.Text:gsub("#","")
        if #hex==6 then
            local r2=tonumber(hex:sub(1,2),16); local g2=tonumber(hex:sub(3,4),16); local b2=tonumber(hex:sub(5,6),16)
            if r2 and g2 and b2 then preview.BackgroundColor3=Color3.fromRGB(r2,g2,b2) end
        end
    end)
    return row, preview
end


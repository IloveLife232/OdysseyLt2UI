local lt2ThemeEnabled=true
local currentLT2BG=Color3.fromRGB(70,90,130)
local currentThemeColors={c1=Color3.fromRGB(74,108,174),c2=Color3.fromRGB(90,90,140),c3=Color3.fromRGB(50,50,78)}
-- Tracks original colors so we can restore them when LT2 theme is turned off
local OriginalColors={}
local ProgressBarGradients={}

local function ApplyLT2Theme(bgColor)
	if not lt2ThemeEnabled then return end
	local TxtColor=Color3.fromRGB(255,255,255)
	local viewport=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)
	for _,v in next,Players.LocalPlayer.PlayerGui:GetChildren() do
		if v.Name~="Chat" and v.Name~="OdysseyUI" and v.Name~="OdysseyTip" and v.Name~="OdysseyNotif" and v.Name~="OdysseyConfirm" and v.Name~="OdysseyProgress" and v.Name~="TargetGui" and v.Name~="ESPGui" and v.Name~="CrosshairGui" then
			for _,d in next,v:GetDescendants() do pcall(function()
				-- Skip large full-screen overlays (fades, transitions) to avoid blacking out the game
				if d:IsA("GuiObject") then
					local sz=d.AbsoluteSize
					if sz.X>=viewport.X*0.85 and sz.Y>=viewport.Y*0.85 then return end
				end
				if not d:FindFirstChild("UICorner") then
					if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("ScrollingFrame") then
						Instance.new("UICorner",d).CornerRadius=UDim.new(0,6)
					end
				end
				if d.Name=="DropShadow" then d:Destroy() end
				if d:IsA("TextButton") or d:IsA("Frame") or d:IsA("ScrollingFrame") then
					-- Save the original color the first time we ever touch this element
					if not OriginalColors[d] then
						OriginalColors[d]={bg=d.BackgroundColor3}
					end
					d.BackgroundColor3=bgColor
				end
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					if not OriginalColors[d] then
						OriginalColors[d]={bg=d.BackgroundColor3,text=d.TextColor3}
					elseif OriginalColors[d].text==nil then
						OriginalColors[d].text=d.TextColor3
					end
					d.TextColor3=TxtColor; d.BackgroundColor3=bgColor; d.Font=Enum.Font.GothamMedium
				end
			end) end
		end
	end
end

local function RevertLT2Theme()
	for d,orig in pairs(OriginalColors) do
		pcall(function()
			if d and d.Parent then
				if orig.bg then d.BackgroundColor3=orig.bg end
				if orig.text then d.TextColor3=orig.text end
			end
		end)
	end
end

Players.LocalPlayer.PlayerGui.ChildAdded:Connect(function() task.wait(0.1); if lt2ThemeEnabled then ApplyLT2Theme(currentLT2BG) end end)
task.defer(function() if lt2ThemeEnabled then ApplyLT2Theme(currentLT2BG) end end)

local TipFrame,TipLbl,OdysseyMainRef,OdysseyGradient,OdysseyGuiRef
local function ApplyTheme(name)
	local theme=Themes[name]
	if not theme then return end
	local newSeq=ColorSequence.new({
		ColorSequenceKeypoint.new(0,theme.c1),
		ColorSequenceKeypoint.new(0.5,theme.c2),
		ColorSequenceKeypoint.new(1,theme.c3),
	})
	-- Destroy and recreate the gradient fresh to force a real repaint (mutating .Color alone can fail to refresh)
	if OdysseyMainRef then
		pcall(function()
			for _,old in ipairs(OdysseyMainRef:GetChildren()) do
				if old:IsA("UIGradient") then old:Destroy() end
			end
			local grad=Instance.new("UIGradient")
			grad.Color=newSeq
			grad.Rotation=120
			grad.Parent=OdysseyMainRef
			OdysseyGradient=grad
		end)
	end
	currentLT2BG=theme.LT2BG
	currentThemeColors={c1=theme.c1,c2=theme.c2,c3=theme.c3}
	ApplyLT2Theme(currentLT2BG)
end

local function New(class,props)
	local o=Instance.new(class)
	for k,v in pairs(props) do o[k]=v end
	return o
end


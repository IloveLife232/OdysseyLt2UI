local function MakeDraggable(frame,handle)
	local drag,start,spos=false
	handle.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true;start=i.Position;spos=frame.Position end
	end)
	handle.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
			local d=i.Position-start
			frame.Position=UDim2.new(spos.X.Scale,spos.X.Offset+d.X,spos.Y.Scale,spos.Y.Offset+d.Y)
		end
	end)
end
local function formatTime(s) return string.format("%d:%02d",math.floor(s/60),s%60) end
local function formatMoney(n)
	n=math.floor(tonumber(n) or 0)
	local s=tostring(n)
	local result=""
	local len=#s
	for i=1,len do
		if i>1 and (len-i+1)%3==0 then result=result.."," end
		result=result..s:sub(i,i)
	end
	return result
end

local function AddTooltip(obj,text,showIcon,iconParent,iconPos,darkIcon)
	if not text or text=="" then return end
	local function showTip()
		if not TipLbl or not TipFrame then return end
		TipLbl.Text=text
		if OdysseyMainRef then
			local p=OdysseyMainRef.AbsolutePosition
			local s=OdysseyMainRef.AbsoluteSize
			TipFrame.Position=UDim2.new(0,p.X+s.X+8,0,p.Y+60)
		end
		TipFrame.Visible=true
	end
	if showIcon and iconParent then
		local iconBG=darkIcon and Color3.fromRGB(20,20,20) or Color3.fromRGB(255,255,255)
		local iconTxt=darkIcon and Color3.fromRGB(255,255,255) or Color3.fromRGB(255,255,255)
		local ib=New("TextButton",{Text="i",TextSize=8,TextColor3=iconTxt,BackgroundColor3=iconBG,BackgroundTransparency=darkIcon and 0.15 or 0.85,BorderSizePixel=0,Font=Enum.Font.GothamBold,Size=UDim2.new(0,15,0,15),Position=iconPos or UDim2.new(1,-21,0.5,-7),AutoButtonColor=false,ZIndex=5,Parent=iconParent})
		Corner(ib,8)
		if darkIcon then GlassStroke(ib,0.85) else GlassStroke(ib,0.6) end
		ib.MouseEnter:Connect(function() showTip() end)
		ib.MouseLeave:Connect(function() if TipFrame then TipFrame.Visible=false end end)
		return
	end
	obj.MouseEnter:Connect(function() showTip() end)
	obj.MouseLeave:Connect(function() if TipFrame then TipFrame.Visible=false end end)
end

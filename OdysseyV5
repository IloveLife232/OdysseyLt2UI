    local settingsPage=New("Frame",{Name="Page_Settings",Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Visible=false,Parent=ContentScroll})
    local spvl=VList(settingsPage,7)
    New("TextLabel",{Text="Settings",TextSize=14,TextColor3=T.Text,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(1,0,0,20),TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=0,Parent=settingsPage})
    New("Frame",{Size=UDim2.new(1,0,0,1),BackgroundColor3=T.Border,BorderSizePixel=0,LayoutOrder=1,Parent=settingsPage})
    local settingsListF=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,LayoutOrder=2,Parent=settingsPage}); VList(settingsListF,6)
    local settingsTab=setmetatable({_list=settingsListF,_order=0},Tab)

    -- Settings nav button at bottom
    local settingsBtn=New("TextButton",{Text="⚙",TextSize=16,TextColor3=T.TextDim,BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=1,BorderSizePixel=0,Font=Enum.Font.GothamBold,Size=UDim2.new(1,0,0,32),AutoButtonColor=false,Parent=SideBottom})
    Corner(settingsBtn,7)
    AddTooltip(settingsBtn,"Settings")
    local settingsBar=New("Frame",{Size=UDim2.new(0,2,0,18),Position=UDim2.new(0,-2,0.5,-9),BackgroundColor3=T.Accent,BorderSizePixel=0,Visible=false,Parent=settingsBtn}); Corner(settingsBar,1)
    table.insert(win._tabs,{btn=settingsBtn,bar=settingsBar,page=settingsPage})
    settingsBtn.MouseButton1Click:Connect(function()
        for _,t in ipairs(win._tabs) do t.btn.BackgroundTransparency=1; t.btn.TextColor3=T.TextDim; t.bar.Visible=false; t.page.Visible=false end
        settingsBtn.BackgroundTransparency=0; settingsBtn.BackgroundColor3=T.BG2; settingsBtn.TextColor3=T.Text; settingsBar.Visible=true; settingsPage.Visible=true
    end)

    -- UI Visibility section
    settingsTab:CreateSection("UI VISIBILITY")
    local toggleUIBtn = settingsTab:CreateButton({
        Name="Toggle UI",
        Tooltip="Show or hide the Odyssey UI window",
        Callback=function() Body.Visible=not Body.Visible end,
    })
    local kbRow2=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,28),LayoutOrder=settingsTab._order,Parent=settingsTab._list}); settingsTab._order=settingsTab._order+1
    New("TextLabel",{Text="Toggle keybind",TextSize=12,TextColor3=T.Text,Font=Enum.Font.GothamMedium,BackgroundTransparency=1,Size=UDim2.new(1,-80,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=kbRow2})
    local kbBox2=New("TextButton",{Text=toggleKey.Name,TextSize=10,TextColor3=T.Accent,BackgroundColor3=T.BG3,BorderSizePixel=0,Font=Enum.Font.GothamBold,Size=UDim2.new(0,72,0,24),Position=UDim2.new(1,-72,0.5,-12),AutoButtonColor=false,Parent=kbRow2}); Corner(kbBox2,7); Stroke(kbBox2,T.Border,1)
    AddTooltip(kbRow2,"Click the box then press any key to set a new keybind",true,kbRow2)
    local awaiting2=false
    kbBox2.MouseButton1Click:Connect(function() awaiting2=true; kbBox2.Text="..."; kbBox2.TextColor3=T.TextDim end)
    UserInputService.InputBegan:Connect(function(i,gp)
        if awaiting2 and not gp then toggleKey=i.KeyCode; kbBox2.Text=i.KeyCode.Name; kbBox2.TextColor3=T.Accent; awaiting2=false end
    end)

    -- Theme section
    settingsTab:CreateSection("THEME")
    local themeNames={"🌲 Forest","🌙 Midnight","🌊 Ocean","🌹 Rose","🔥 Ember"}
    local themeDD=settingsTab:CreateDropdown({
        Name="UI Theme",
        Options=themeNames,
        CurrentOption="🌲 Forest",
        Tooltip="Change the color theme of Odyssey and LT2 menus",
        Callback=function(v)
            ApplyTheme(v)
        end,
    })

    settingsTab:CreateToggle({
        Name="LT2 theme",
        Description="Apply Odyssey theme colors to LT2 game menus",
        CurrentValue=true,
        Tooltip="Toggle LT2 menu recolor on or off",
        Callback=function(v)
            lt2ThemeEnabled=v
            if v then
                ApplyLT2Theme(currentLT2BG, true)
            else
                -- Reset LT2 to default
                local defaultBG=Color3.fromRGB(38,38,40)
                local TxtColor=Color3.fromRGB(255,255,255)
                for _,gui in next, Players.LocalPlayer.PlayerGui:GetChildren() do
                    if gui.Name~="Chat" and gui.Name~="OdysseyUI" and gui.Name~="OdysseyTip" and gui.Name~="OdysseyNotif" then
                        for _,d in next, gui:GetDescendants() do
                            if d:IsA("TextButton") or d:IsA("Frame") or d:IsA("ScrollingFrame") then
                                d.BackgroundColor3=defaultBG
                            end
                            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                                d.TextColor3=TxtColor; d.BackgroundColor3=defaultBG
                            end
                        end
                    end
                end
            end
        end,
    })

    function win:CreateUpdateLog(opts2) return Window.CreateUpdateLog(self,opts2) end
    function win:CreateDiscordButton(opts2) return Window.CreateDiscordButton(self,opts2) end
    function win:CreateTab(opts2) return Window.CreateTab(self,opts2) end

    return win
end

return Odyssey

		if not enter and cb then cb(tb.Text) end
	end)
	reg(self,opts.Name,card)
	local api={}
	function api:Set(o) if o.Value then tb.Text=tostring(o.Value) end end
	function api:GetValue() return tb.Text end
	function api:Destroy() card:Destroy() end
	return api

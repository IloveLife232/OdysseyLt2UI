function Tab:CreateToggle(opts)
    opts=opts or {}
    local enabled=opts.CurrentValue or false; local cb=opts.Callback; local flag=opts.Flag
    local row=_row(self._list,self._order); self._order=self._order+1
    local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row}); VList(vl,3)
    local topRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,28),Parent=vl})

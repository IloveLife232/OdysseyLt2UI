						changed=true
					end
					if changed then alreadyBlurred[obj]=true end
				end
			end
		end)
	end

	local function BlurPlayerGuiPass()
		if not realUsername or realUsername=="" then return end
		for _,gui in ipairs(PlayerGui:GetChildren()) do
			for _,obj in ipairs(gui:GetDescendants()) do
				BlurTextIn(obj)
			end
		end
	end

	local function BlurWorkspacePass()
		if not realUsername or realUsername=="" then return end
		pcall(function()
			for _,obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
					for _,child in ipairs(obj:GetDescendants()) do
						BlurTextIn(child)
					end
				end
			end
		end)
	end

	local function StartBlurLoop()
		if blurLoopActive then return end
		blurLoopActive=true
		task.spawn(function()
			local cycles=0
			while blurIdentityEnabled do
				BlurPlayerGuiPass() -- cheap, every pass
				cycles+=1
				if cycles%4==0 then
					BlurWorkspacePass() -- expensive, only every 4th pass (~6s)
				end
				task.wait(1.5)
			end
			blurLoopActive=false
		end)
	end


            local dot=New("Frame",{Size=UDim2.new(0,6,0,6),Position=UDim2.new(0,0,0.5,-3),BackgroundColor3=dotColors[entry.Type] or T.TextDim,BorderSizePixel=0,Parent=eRow}); Corner(dot,3)
            New("TextLabel",{Text=entry.Text or "",TextSize=10,TextColor3=T.TextDim,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,-42,1,0),Position=UDim2.new(0,12,0,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=eRow})
            local tagF=New("Frame",{Size=UDim2.new(0,0,0,14),AutomaticSize=Enum.AutomaticSize.X,BackgroundColor3=bgColors[entry.Type] or T.BG3,BorderSizePixel=0,Position=UDim2.new(1,-30,0.5,-7),Parent=eRow}); Corner(tagF,4); Pad(tagF,0,5,0,5)
            New("TextLabel",{Text=entry.Type or "?",TextSize=8,TextColor3=dotColors[entry.Type] or T.TextDim,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(0,0,1,0),AutomaticSize=Enum.AutomaticSize.X,Parent=tagF})
        end

        return tab
    end

    -- Discord button
    -- win:CreateDiscordButton({Label="Join our Discord", Url="https://discord.gg/example"})
    function win:CreateDiscordButton(opts)
        opts = opts or {}
        local label = opts.Label or "Join Discord Server"

        local tab = self:CreateTab({Name="DSC", ShowTitle=false})

        local btn=New("TextButton",{
            Text=label, TextSize=11, TextColor3=T.White,
            BackgroundColor3=Color3.fromRGB(88,101,242), BorderSizePixel=0,
            Font=Enum.Font.GothamBold, Size=UDim2.new(1,0,0,36),
            AutoButtonColor=false, Parent=tab._list,
        })
        Corner(btn,10)
        btn.MouseEnter:Connect(function() TweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(70,82,200)}):Play() end)
        btn.MouseLeave:Connect(function() TweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(88,101,242)}):Play() end)
        btn.MouseButton1Click:Connect(function()
            if opts.Callback then opts.Callback() end
        end)

        return tab
    end

    return win
end

-- First tab auto-activate when first tab added
local oldCreateTab = Window.CreateTab
function Window:CreateTab(opts)
    local t = oldCreateTab(self, opts)
    if #self._tabs==1 then
        self:_activateFirst()
    end
    return t
end

return Odyssey

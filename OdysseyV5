		local p,s=btn.AbsolutePosition,btn.AbsoluteSize
		local vp=workspace.CurrentCamera.ViewportSize
		local h=pop.AbsoluteSize.Y
		local y=p.Y+s.Y+6
		if y+h>vp.Y-50 then y=p.Y-h-6 end -- not enough room below: open upwards
		pop.Position=UDim2.fromOffset(p.X,y)
	end
	local function setOpen(v)
		pop.Visible=v
		if v then place(); task.defer(place) end
	end
	btn.MouseButton1Click:Connect(function() setOpen(not pop.Visible) end)
	RunService.Heartbeat:Connect(function() if pop.Visible then place() end end)
	main:GetPropertyChangedSignal("Visible"):Connect(function() if not main.Visible then setOpen(false) end end)
	btn:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() if pop.Visible and btn.AbsoluteSize.Y==0 then setOpen(false) end end)
	UserInputService.InputBegan:Connect(function(i)
		if not pop.Visible then return end
		if i.UserInputType~=Enum.UserInputType.MouseButton1 and i.UserInputType~=Enum.UserInputType.Touch then return end
		local pos=i.Position
		local function inside(o)
			local ap,as=o.AbsolutePosition,o.AbsoluteSize
			return pos.X>=ap.X and pos.X<=ap.X+as.X and pos.Y>=ap.Y and pos.Y<=ap.Y+as.Y
		end
		if not inside(pop) and not inside(btn) then setOpen(false) end
	end)
	-- hide when you switch away from Home
	local homeTab=self._tabs and self._tabs[1]
	if homeTab then homeTab.page:GetPropertyChangedSignal("Visible"):Connect(function() if not homeTab.page.Visible then setOpen(false) end end) end
end


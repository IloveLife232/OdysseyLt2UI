			options={}
			for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
			if open then build(options) end
		end)
		Players.PlayerRemoving:Connect(function()
			task.wait(0.1)
			options={}
			for _,p in ipairs(Players:GetPlayers()) do table.insert(options,p.Name) end
			if open then build(options) end
		end)
	end
	_div(self._list,self._order); self._order=self._order+1
	local api={}
	function api:Set(o)
		if o.Options then options=o.Options; build(options) end
		if o.CurrentOption~=nil then selected=o.CurrentOption; header.Text=selText(); build(options) end
	end
	function api:GetValue() return selected end
	function api:Destroy() row:Destroy() end
	return api
end


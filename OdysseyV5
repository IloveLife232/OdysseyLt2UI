function Window:Notify(nopts)
	nopts=nopts or {}
	local h=GetNotifHolder()
	NotifCount=NotifCount+1
	-- keep at most 5 on screen, drop the oldest
	local frames={}
	for _,ch in ipairs(h:GetChildren()) do if ch:IsA("Frame") then table.insert(frames,ch) end end
	table.sort(frames,function(a,b) return a.LayoutOrder<b.LayoutOrder end)
	while #frames>=5 do frames[1]:Destroy(); table.remove(frames,1) end
	local wrap=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,LayoutOrder=NotifCount,Parent=h})

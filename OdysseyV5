local function ThemeSeq()
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0,currentThemeColors.c1),
		ColorSequenceKeypoint.new(0.5,currentThemeColors.c2),
		ColorSequenceKeypoint.new(1,currentThemeColors.c3),
	})
end
-- Gradient that follows the active theme (registered with the theme updater)
local function AccentGrad(obj,rot)
	local g=Instance.new("UIGradient")
	g.Color=ThemeSeq()
	g.Rotation=rot or 0
	g.Parent=obj
	ProgressBarGradients[g]=true
	obj.AncestryChanged:Connect(function(_,p) if not p then ProgressBarGradients[g]=nil end end)
	return g
end
-- Shared layout-order counter so sections and their parent tab never collide
-- A UIGradient on a TextButton also tints its text (white text became invisible),
-- so gradient buttons get a gradient "Fill" frame behind a separate text label.
local function GradientButton(btn,radius)
	btn.BackgroundTransparency=1
	local fill=Instance.new("Frame")
	fill.Name="Fill"; fill.Size=UDim2.new(1,0,1,0); fill.BackgroundColor3=Color3.new(1,1,1)
	fill.BorderSizePixel=0; fill.ZIndex=btn.ZIndex; fill.Parent=btn
	local uc=Instance.new("UICorner"); uc.CornerRadius=UDim.new(0,radius or 9); uc.Parent=fill
	AccentGrad(fill,0)
	local lbl=Instance.new("TextLabel")
	lbl.Name="Label"; lbl.Text=btn.Text; lbl.TextSize=btn.TextSize; lbl.Font=btn.Font
	lbl.TextColor3=Color3.new(1,1,1); lbl.BackgroundTransparency=1; lbl.Size=UDim2.new(1,-12,1,0)
	lbl.Position=UDim2.new(0,6,0,0); lbl.TextTruncate=Enum.TextTruncate.AtEnd; lbl.ZIndex=btn.ZIndex+1; lbl.Parent=btn
	btn.TextTransparency=1
	btn:GetPropertyChangedSignal("Text"):Connect(function() lbl.Text=btn.Text end)
	return fill,lbl
end
local function take(self)
	local c=self._ctr
	local o=self._order or 0
	if c then o=math.max(c.n,o); c.n=o+1 end
	self._order=o+1
	return o
end

-- Restyles Lumber Tycoon 2's own menus (shop, load/save, notices...) to match the Odyssey look:
-- dark panels tinted by the active theme, raised buttons with a thin outline, light text.
local SKIP_GUIS={Chat=true,OdysseyUI=true,OdysseyTip=true,OdysseyNotif=true,OdysseyConfirm=true,OdysseyProgress=true,TargetGui=true,ESPGui=true,CrosshairGui=true}
-- Restyles Lumber Tycoon 2's own menus to match the Odyssey look (one ScreenGui at a time)
local function StyleLT2Gui(v,themeColor)
	if SKIP_GUIS[v.Name] then return end
	local panelCol=C.BG:Lerp(themeColor,0.14)
	local buttonCol=C.Hover:Lerp(themeColor,0.25)
	local viewport=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920,1080)
	local n=0
	for _,d in ipairs(v:GetDescendants()) do
		n=n+1
		if n%250==0 then task.wait() end -- spread work over frames so there is no freeze
		pcall(function()
				-- Skip large full-screen overlays (fades, transitions) to avoid blacking out the game
				if d:IsA("GuiObject") then
					local sz=d.AbsoluteSize
					if sz.X>=viewport.X*0.85 and sz.Y>=viewport.Y*0.85 then return end
				end
				if d.Name=="DropShadow" then d:Destroy() return end
				if not d:IsA("GuiObject") then return end
				if not OriginalColors[d] then
					local o={bg=d.BackgroundColor3}
					if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then o.text=d.TextColor3; o.font=d.Font end
					OriginalColors[d]=o
				end
				if (d:IsA("Frame") or d:IsA("TextButton") or d:IsA("ScrollingFrame") or d:IsA("TextBox")) and not d:FindFirstChildWhichIsA("UICorner") then
					local uc=Instance.new("UICorner"); uc.Name="OdysseyLT2"; uc.CornerRadius=UDim.new(0,d:IsA("TextButton") and 8 or 10); uc.Parent=d
				end
				if d:IsA("TextButton") or d:IsA("ImageButton") then
					d.BackgroundColor3=buttonCol
					if d.BackgroundTransparency<0.9 and not d:FindFirstChild("OdysseyLT2Stroke") then
						local st=Instance.new("UIStroke"); st.Name="OdysseyLT2Stroke"; st.Color=C.FieldStroke; st.Thickness=1
						st.ApplyStrokeMode=Enum.ApplyStrokeMode.Border; st.Parent=d
					end
				elseif d:IsA("TextBox") then
					d.BackgroundColor3=C.Field
				elseif d:IsA("Frame") or d:IsA("ScrollingFrame") or d:IsA("TextLabel") then
					d.BackgroundColor3=panelCol
				end
				if d:IsA("ScrollingFrame") then d.ScrollBarImageColor3=C.Muted end
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					d.TextColor3=C.Text
					d.Font=d:IsA("TextButton") and Enum.Font.GothamBold or Enum.Font.GothamMedium
				end
		end)
	end
end
local lt2Busy,lt2Again=false,false
local function ApplyLT2Theme(themeColor)
	if not lt2ThemeEnabled then return end
	-- if a pass is already running (e.g. dragging a colour picker), just queue one more
	if lt2Busy then lt2Again=true return end
	lt2Busy=true
	task.spawn(function()
		repeat
			lt2Again=false
			for _,v in ipairs(Players.LocalPlayer.PlayerGui:GetChildren()) do
				if not lt2ThemeEnabled then break end
				StyleLT2Gui(v,currentLT2BG)
			end
		until not lt2Again
		lt2Busy=false
	end)
end

local function RevertLT2Theme()
	for d,orig in pairs(OriginalColors) do
		pcall(function()
			if d and d.Parent then
				if orig.bg then d.BackgroundColor3=orig.bg end
				if orig.text then d.TextColor3=orig.text end
				if orig.font then d.Font=orig.font end
				for _,ch in ipairs(d:GetChildren()) do
					if ch.Name=="OdysseyLT2Stroke" or ch.Name=="OdysseyLT2" then ch:Destroy() end
				end
			end
		end)
	end
	OriginalColors={}
end

-- only style the menu that was just added, instead of rescanning every menu
Players.LocalPlayer.PlayerGui.ChildAdded:Connect(function(v)
	if SKIP_GUIS[v.Name] then return end
	task.wait(0.1)
	if lt2ThemeEnabled and v.Parent then StyleLT2Gui(v,currentLT2BG) end
end)
task.defer(function() if lt2ThemeEnabled then ApplyLT2Theme(currentLT2BG) end end)

local TipFrame,TipLbl,OdysseyMainRef,OdysseyGradient,OdysseyGuiRef
local function ApplyTheme(name)
	local theme=Themes[name]
	if not theme then return end
	local newSeq=ColorSequence.new({
		ColorSequenceKeypoint.new(0,theme.c1),
		ColorSequenceKeypoint.new(0.5,theme.c2),
		ColorSequenceKeypoint.new(1,theme.c3),
	})
	-- Destroy and recreate the gradient fresh to force a real repaint (mutating .Color alone can fail to refresh)
	if OdysseyMainRef then
		pcall(function()
			for _,old in ipairs(OdysseyMainRef:GetChildren()) do
				if old:IsA("UIGradient") then old:Destroy() end
			end
			local grad=Instance.new("UIGradient")
			grad.Color=newSeq
			grad.Rotation=120
			grad.Parent=OdysseyMainRef
			OdysseyGradient=grad
		end)
	end
	currentLT2BG=theme.LT2BG
	currentThemeColors={c1=theme.c1,c2=theme.c2,c3=theme.c3}
	ApplyLT2Theme(currentLT2BG)
end

local function New(class,props)
	local o=Instance.new(class)
	for k,v in pairs(props) do o[k]=v end
	return o
end

-- Tints whichever visual child an orb has (real icon image or fallback text glyph)
local function SetOrbTint(orb, color)
	for _,child in ipairs(orb:GetChildren()) do
		if child:IsA("ImageLabel") then
			child.ImageColor3 = color
		elseif child:IsA("TextLabel") then
			child.TextColor3 = color
		end
	end
end
local function Corner(p,r)
	local c=Instance.new("UICorner")
	c.CornerRadius=UDim.new(0,r or 8)
	c.Parent=p
end
local function GlassStroke(p,alpha)
	local s=Instance.new("UIStroke")
	s.Color=Color3.fromRGB(47,53,85)
	s.Thickness=1
	s.Transparency=0
	s.Parent=p
	return s
end
local function Stroke(p,col,th,alpha)
	local old=p:FindFirstChildWhichIsA("UIStroke")
	if old then old:Destroy() end
	local s=Instance.new("UIStroke")
	s.Color=col or Color3.fromRGB(255,255,255)
	s.Thickness=th or 1
	s.Transparency=alpha or 0.75
	s.Parent=p
	return s
end
local function Pad(p,t,r,b,l)
	local u=Instance.new("UIPadding")
	u.PaddingTop=UDim.new(0,t or 8)
	u.PaddingRight=UDim.new(0,r or 8)
	u.PaddingBottom=UDim.new(0,b or 8)
	u.PaddingLeft=UDim.new(0,l or 8)
	u.Parent=p
end
local function VList(p,gap)
	local l=Instance.new("UIListLayout")
	l.FillDirection=Enum.FillDirection.Vertical
	l.Padding=UDim.new(0,gap or 6)
	l.SortOrder=Enum.SortOrder.LayoutOrder
	l.Parent=p
	return l
end
local function HList(p,gap)
	local l=Instance.new("UIListLayout")
	l.FillDirection=Enum.FillDirection.Horizontal
	l.Padding=UDim.new(0,gap or 10)
	l.SortOrder=Enum.SortOrder.LayoutOrder
	l.VerticalAlignment=Enum.VerticalAlignment.Center
	l.Parent=p
	return l
end
local function MakeDraggable(frame,handle)
	local drag,start,spos=false
	handle.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true;start=i.Position;spos=frame.Position end
	end)
	handle.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
			local d=i.Position-start
			frame.Position=UDim2.new(spos.X.Scale,spos.X.Offset+d.X,spos.Y.Scale,spos.Y.Offset+d.Y)
		end
	end)
end
local function formatTime(s) return string.format("%d:%02d",math.floor(s/60),s%60) end
local function formatMoney(n)
	n=math.floor(tonumber(n) or 0)
	local s=tostring(n)
	local result=""
	local len=#s
	for i=1,len do
		if i>1 and (len-i+1)%3==0 then result=result.."," end
		result=result..s:sub(i,i)
	end
	return result
end

local function AddTooltip(obj,text,showIcon,iconParent,iconPos,darkIcon)
	if not text or text=="" then return end
	local function showTip()
		if not TipLbl or not TipFrame then return end
		TipLbl.Text=text
		if OdysseyMainRef then
			local p=OdysseyMainRef.AbsolutePosition
			local s=OdysseyMainRef.AbsoluteSize
			TipFrame.Position=UDim2.new(0,p.X+s.X+8,0,p.Y+60)
		end
		TipFrame.Visible=true
	end
	if showIcon and iconParent then
		local iconBG=Color3.fromRGB(21,25,41)
		local iconTxt=darkIcon and Color3.fromRGB(255,255,255) or Color3.fromRGB(255,255,255)
		local ib=New("TextButton",{Text="i",TextSize=10,TextColor3=iconTxt,BackgroundColor3=iconBG,BackgroundTransparency=darkIcon and 0.15 or 0.85,BorderSizePixel=0,Font=Enum.Font.BuilderSansBold,Size=UDim2.new(0,15,0,15),Position=iconPos or UDim2.new(1,-21,0.5,-7),AutoButtonColor=false,ZIndex=5,Parent=iconParent})
		Corner(ib,8)
		if darkIcon then GlassStroke(ib,0.85) else GlassStroke(ib,0.6) end
		ib.MouseEnter:Connect(function() showTip() end)
		ib.MouseLeave:Connect(function() if TipFrame then TipFrame.Visible=false end end)
		return
	end
	obj.MouseEnter:Connect(function() showTip() end)
	obj.MouseLeave:Connect(function() if TipFrame then TipFrame.Visible=false end end)
end
local Tab={}
Tab.__index=Tab
local LEFT=Enum.TextXAlignment.Left
local AUTO_Y=Enum.AutomaticSize.Y
local function _row(parent,order) return New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,LayoutOrder=order or 0,Parent=parent}) end
-- Dividers are replaced by card spacing in V6; kept as invisible frames for compatibility
local function _div(parent,order) return New("Frame",{Size=UDim2.new(1,0,0,0),BackgroundTransparency=1,Visible=false,LayoutOrder=order or 0,Parent=parent}) end
local function _card(parent,order)
	local f=New("Frame",{BackgroundColor3=C.Card,BackgroundTransparency=0.15,BorderSizePixel=0,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,LayoutOrder=order or 0,Parent=parent})
	Corner(f,10); Stroke(f,C.CardStroke,1,0); Pad(f,9,12,9,12)
	return f
end
-- Where an element goes: inside the current section card (flat row + divider),
-- or as a standalone card if the tab has no section yet.
local function _slot(self,asCard,weight,noDiv)
	local root=self._root
	local sec=root and root.secs[self._list]
	if sec then
		if not noDiv and sec.n>0 then
			New("Frame",{Size=UDim2.new(1,0,0,1),BackgroundColor3=C.CardStroke,BorderSizePixel=0,LayoutOrder=take(self),Parent=self._list})
		end
		if not noDiv then sec.n=sec.n+1 end
		root.w[sec.col]=root.w[sec.col]+(weight or 1)
		local f=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,LayoutOrder=take(self),Parent=self._list})
		Pad(f,noDiv and 5 or 9,0,noDiv and 5 or 9,0)
		return f
	end
	if asCard then return _card(self._list,take(self)) end
	return _row(self._list,take(self))
end
local function _title(parent,text,desc,order)
	local f=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,LayoutOrder=order or 0,Parent=parent})
	VList(f,2)
	New("TextLabel",{Text=text or "",TextSize=14,TextColor3=C.Text,Font=Enum.Font.BuilderSansMedium,BackgroundTransparency=1,Size=UDim2.new(1,0,0,20),TextXAlignment=LEFT,TextTruncate=Enum.TextTruncate.AtEnd,LayoutOrder=1,Parent=f})
	if desc and desc~="" then
		New("TextLabel",{Text=desc,TextSize=12,TextColor3=C.Muted,Font=Enum.Font.BuilderSansMedium,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,TextWrapped=true,TextXAlignment=LEFT,LayoutOrder=2,Parent=f})
	end
	return f
end
local function _fieldBox(props)
	local o=New(props.Class or "TextBox",{Text=props.Text or "",TextSize=props.TextSize or 13,TextColor3=C.Text,BackgroundColor3=C.Field,BackgroundTransparency=0,BorderSizePixel=0,Font=props.Font or Enum.Font.BuilderSansMedium,Size=props.Size or UDim2.new(1,0,0,32),Position=props.Position,AnchorPoint=props.AnchorPoint,TextXAlignment=props.Align or LEFT,LayoutOrder=props.LayoutOrder or 0,Parent=props.Parent})
	if o:IsA("TextBox") then o.ClearTextOnFocus=false; o.PlaceholderText=props.Placeholder or ""; o.PlaceholderColor3=C.Muted end
	if o:IsA("TextButton") then o.AutoButtonColor=false end
	Corner(o,8)
	local st=Stroke(o,C.FieldStroke,1,0)
	if o:IsA("TextBox") then
		o.Focused:Connect(function() st.Color=C.Focus end)
		o.FocusLost:Connect(function() st.Color=C.FieldStroke end)
	end
	return o,st
end
local function reg(self,name,row)
	local w=self._win
	if w and w._searchItems and name then
		local root=self._root
		local sec=root and root.secs[self._list]
		table.insert(w._searchItems,{n=tostring(name):lower(),row=row,page=self._tabData and self._tabData.page,sec=sec and sec.card})
	end
end
local function regSection(self,row)
	local w=self._win
	if w and w._searchSections then table.insert(w._searchSections,row) end
end
local function tipOnly(opts) return (not opts.Description) and opts.Tooltip or nil end

function Tab:CreateSection(name)
	local root=self._root
	if not root then return self end
	-- masonry: put the new section card in the lighter column
	local c=(root.w[2]<root.w[1]) and 2 or 1
	root.secN=root.secN+1
	root.colsFrame.Visible=true
	local card=New("Frame",{Name="Section_"..tostring(name),BackgroundColor3=C.Card,BackgroundTransparency=0.15,BorderSizePixel=0,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,LayoutOrder=root.secN,Parent=root.compact and root.cols[1] or root.cols[c]})
	card:SetAttribute("Col",c)
	Corner(card,12); Stroke(card,C.CardStroke,1,0); Pad(card,11,14,5,14)
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,Parent=card})
	VList(vl,2)
	local h=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,18),LayoutOrder=0,Parent=vl})
	local bar=New("Frame",{Size=UDim2.new(0,3,0,12),Position=UDim2.new(0,0,0.5,-6),BackgroundColor3=C.White,BorderSizePixel=0,Parent=h})
	Corner(bar,2); AccentGrad(bar,90)
	New("TextLabel",{Text=tostring(name or ""):upper(),TextSize=12,TextColor3=C.Dim,Font=Enum.Font.BuilderSansBold,BackgroundTransparency=1,Size=UDim2.new(1,-10,1,0),Position=UDim2.new(0,10,0,0),TextXAlignment=LEFT,TextTruncate=Enum.TextTruncate.AtEnd,Parent=h})
	local list=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,LayoutOrder=1,Parent=vl})
	VList(list,0)
	root.secs[list]={n=0,col=c,card=card}
	root.w[c]=root.w[c]+0.6
	table.insert(root.cards,card)
	-- everything created on this tab after this call lands in this section
	self._list=list
	regSection(self,card)
	return setmetatable({_list=list,_order=0,_ctr=self._ctr,_root=root,_tabData=self._tabData,_win=self._win},Tab)
end
function Tab:CreateDivider() _div(self._list,take(self)) end

function Tab:CreateLabel(opts)
	opts=opts or {}
	local colors={C.Dim,T.Blue,T.Yellow}
	local prefixes={"","i  ","!  "}
	local inSec=self._root and self._root.secs[self._list]
	local row=_slot(self,false,0.5,true)
	local lbl=New("TextLabel",{Text=(prefixes[opts.Style or 1] or "")..(opts.Text or ""),TextSize=13,TextColor3=colors[opts.Style or 1] or C.Dim,Font=Enum.Font.BuilderSansMedium,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,TextXAlignment=LEFT,TextWrapped=true,Parent=row})
	if not inSec then Pad(row,2,4,2,4) end
	local api={}
	function api:Set(o) if o.Text then lbl.Text=o.Text end end
	function api:Destroy() row:Destroy() end
	return api
end

function Tab:CreateParagraph(opts)
	opts=opts or {}
	local card=_slot(self,true)
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,Parent=card})
	VList(vl,4)
	if opts.Title then New("TextLabel",{Text=opts.Title,TextSize=14,TextColor3=C.Text,Font=Enum.Font.BuilderSansBold,BackgroundTransparency=1,Size=UDim2.new(1,0,0,16),TextXAlignment=LEFT,Parent=vl}) end
	New("TextLabel",{Text=opts.Text or "",TextSize=13,TextColor3=C.Dim,Font=Enum.Font.BuilderSansMedium,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,TextXAlignment=LEFT,TextWrapped=true,Parent=vl})
	local api={}
	function api:Destroy() card:Destroy() end
	return api
end

-- opts.Style = "Primary" | "Danger" | nil (default)
-- opts.SameRow = true puts this button next to the button created just before it (half width each)
local LastButton=setmetatable({},{__mode="k"})
function Tab:CreateButton(opts)
	opts=opts or {}
	local cb=opts.Callback
	local style=opts.Style
	local list=self._list
	local prev=opts.SameRow and LastButton[list]
	local row,btnSize,btnPos
	if prev and prev.row.Parent and prev.btn.Parent then
		LastButton[list]=nil
		row=prev.row
		prev.btn.Size=UDim2.new(0.5,-4,0,36)
		btnSize=UDim2.new(0.5,-4,0,36); btnPos=UDim2.new(0.5,4,0,0)
	else
		local inSec=self._root and self._root.secs[list]
		row=_slot(self,false,0.8,true)
		if not inSec then Pad(row,2,0,2,0) end
		btnSize=UDim2.new(1,0,0,36); btnPos=UDim2.new(0,0,0,0)
	end
	local btn=New("TextButton",{Text=opts.Name or "Button",TextSize=14,TextColor3=C.Text,BackgroundColor3=C.Hover,BackgroundTransparency=0,BorderSizePixel=0,Font=Enum.Font.BuilderSansMedium,Size=btnSize,Position=btnPos,TextTruncate=Enum.TextTruncate.AtEnd,AutoButtonColor=false,Parent=row})
	if not prev then LastButton[list]={row=row,btn=btn} end
	Corner(btn,9)
	local st=Stroke(btn,C.FieldStroke,1,0)
	local baseCol=C.Hover
	local hoverCol=C.HoverHi
	local fill
	if style=="Primary" then
		btn.Font=Enum.Font.BuilderSansBold
		st.Transparency=1
		fill=GradientButton(btn,9)
	elseif style=="Danger" then
		btn.BackgroundColor3=C.DangerBg; btn.TextColor3=C.Danger; st.Color=C.DangerStroke
		baseCol=C.DangerBg; hoverCol=Color3.fromRGB(96,36,54)
	else
		local pip=New("Frame",{Size=UDim2.new(0,3,0,16),Position=UDim2.new(0,8,0.5,-8),BackgroundColor3=C.White,BorderSizePixel=0,Parent=btn})
		Corner(pip,2); AccentGrad(pip,90)
	end
	local infoText=opts.Description or opts.Tooltip
	if infoText then
		AddTooltip(btn,infoText,true,btn,nil,true)
		-- keep the button's words clear of the "i" icon: the text gets its own label
		-- with equal space on both sides so it stays centred and never runs under the icon
		local lbl=btn:FindFirstChild("Label")
		if not lbl then
			lbl=Instance.new("TextLabel")
			lbl.Name="Label"; lbl.Text=btn.Text; lbl.TextSize=btn.TextSize; lbl.Font=btn.Font
			lbl.TextColor3=btn.TextColor3; lbl.BackgroundTransparency=1
			lbl.TextTruncate=Enum.TextTruncate.AtEnd; lbl.ZIndex=btn.ZIndex+1; lbl.Parent=btn
			btn.TextTransparency=1
			btn:GetPropertyChangedSignal("Text"):Connect(function() lbl.Text=btn.Text end)
		end
		lbl.Size=UDim2.new(1,-60,1,0)
		lbl.Position=UDim2.new(0,30,0,0)
	end
	if fill then
		btn.MouseEnter:Connect(function() TweenService:Create(fill,TweenInfo.new(0.1),{BackgroundTransparency=0.15}):Play() end)
		btn.MouseLeave:Connect(function() TweenService:Create(fill,TweenInfo.new(0.1),{BackgroundTransparency=0}):Play() end)
		btn.MouseButton1Click:Connect(function()
			fill.BackgroundTransparency=0.35
			TweenService:Create(fill,TweenInfo.new(0.25),{BackgroundTransparency=0}):Play()
			if cb then cb() end
		end)
	else
		btn.MouseEnter:Connect(function() TweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=hoverCol}):Play() end)
		btn.MouseLeave:Connect(function() TweenService:Create(btn,TweenInfo.new(0.1),{BackgroundColor3=baseCol}):Play() end)
		btn.MouseButton1Click:Connect(function()
			btn.BackgroundColor3=style and baseCol or C.Sel
			TweenService:Create(btn,TweenInfo.new(0.25),{BackgroundColor3=baseCol}):Play()
			if cb then cb() end
		end)
	end
	reg(self,opts.Name,row)
	local api={}
	function api:SetName(n) btn.Text=n end
	function api:Destroy() if prev then btn:Destroy() else row:Destroy() end end
	return api
end

function Tab:CreateToggle(opts)
	opts=opts or {}
	local enabled=opts.CurrentValue or false
	local cb=opts.Callback
	local flag=opts.Flag
	local card=_slot(self,true)
	local left=_title(card,opts.Name or "Toggle",opts.Description)
	if opts.Style=="Danger" then
		local nl=left:FindFirstChildWhichIsA("TextLabel"); if nl then nl.TextColor3=C.Danger end
	end
	left.Size=UDim2.new(1,-52,0,0)
	local track=New("Frame",{Size=UDim2.new(0,38,0,20),AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,0,0.5,0),BackgroundColor3=C.Track,BorderSizePixel=0,Parent=card})
	Corner(track,10)
	local on=New("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=C.White,BackgroundTransparency=enabled and 0 or 1,BorderSizePixel=0,Parent=track})
	Corner(on,10); AccentGrad(on,0)
	local thumb=New("Frame",{Size=UDim2.new(0,14,0,14),Position=enabled and UDim2.new(0,21,0.5,-7) or UDim2.new(0,3,0.5,-7),BackgroundColor3=enabled and C.White or C.Knob,BorderSizePixel=0,ZIndex=2,Parent=track})
	Corner(thumb,7)
	if tipOnly(opts) then AddTooltip(card,opts.Tooltip) end
	local hit=New("TextButton",{Text="",BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),ZIndex=3,Parent=card})
	local function render(anim)
		local ti=TweenInfo.new(anim and 0.15 or 0)
		TweenService:Create(on,ti,{BackgroundTransparency=enabled and 0 or 1}):Play()
		TweenService:Create(thumb,ti,{Position=enabled and UDim2.new(0,21,0.5,-7) or UDim2.new(0,3,0.5,-7),BackgroundColor3=enabled and C.White or C.Knob}):Play()
	end
	hit.MouseButton1Click:Connect(function()
		enabled=not enabled
		render(true)
		if cb then cb(enabled) end
		if flag then Odyssey.Flags[flag]=enabled end
	end)
	reg(self,opts.Name,card)
	local api={}
	function api:Set(o)
		if o.CurrentValue~=nil then enabled=o.CurrentValue; render(false) end
	end
	function api:GetValue() return enabled end
	function api:Destroy() card:Destroy() end
	if flag then Odyssey.Flags[flag]=enabled end
	-- Fire once on creation if it starts enabled so the effect applies immediately
	if enabled and cb then cb(enabled) end
	return api
end

function Tab:CreateSlider(opts)
	opts=opts or {}
	local range=opts.Range or {0,100}
	local minV,maxV=range[1],range[2]
	local inc=opts.Increment or 1
	local defV=opts.CurrentValue or minV
	local cb=opts.Callback
	local flag=opts.Flag
	local decimals=0
	do local d=tostring(inc):match("%.(%d+)"); if d then decimals=#d end end
	local function fmt(v) if decimals>0 then return string.format("%."..decimals.."f",v) end return tostring(math.floor(v+0.5)) end
	local function pctOf(v) if maxV==minV then return 0 end return (v-minV)/(maxV-minV) end
	local card=_slot(self,true)
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,Parent=card})
	VList(vl,8)
	local topRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,22),LayoutOrder=1,Parent=vl})
	New("TextLabel",{Text=opts.Name or "Slider",TextSize=14,TextColor3=C.Text,Font=Enum.Font.BuilderSansMedium,BackgroundTransparency=1,Size=UDim2.new(1,-64,1,0),TextXAlignment=LEFT,TextTruncate=Enum.TextTruncate.AtEnd,Parent=topRow})
	local valLbl=_fieldBox({Parent=topRow,Text=fmt(defV),Size=UDim2.new(0,56,0,22),AnchorPoint=Vector2.new(1,0),Position=UDim2.new(1,0,0,0),Align=Enum.TextXAlignment.Center,Font=Enum.Font.BuilderSansBold})
	if opts.Description then
		New("TextLabel",{Text=opts.Description,TextSize=12,TextColor3=C.Muted,Font=Enum.Font.BuilderSansMedium,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=AUTO_Y,TextWrapped=true,TextXAlignment=LEFT,LayoutOrder=2,Parent=vl})
	end
	local holder=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,18),LayoutOrder=3,Parent=vl})
	local trackF=New("Frame",{Size=UDim2.new(1,-8,0,6),Position=UDim2.new(0,4,0.5,-3),BackgroundColor3=C.Track,BorderSizePixel=0,Parent=holder})
	Corner(trackF,3)
	local pct=pctOf(defV)
	local fill=New("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=C.White,BorderSizePixel=0,Parent=trackF})
	Corner(fill,3); AccentGrad(fill,0)
	local thumbBtn=New("TextButton",{Text="",Size=UDim2.new(0,16,0,16),Position=UDim2.new(pct,-8,0.5,-8),BackgroundColor3=C.White,BorderSizePixel=0,AutoButtonColor=false,ZIndex=2,Parent=trackF})
	Corner(thumbBtn,8)
	if tipOnly(opts) then AddTooltip(topRow,opts.Tooltip) end
	local function setVisual(v)
		local p=pctOf(v)
		valLbl.Text=fmt(v)
		fill.Size=UDim2.new(p,0,1,0)
		thumbBtn.Position=UDim2.new(p,-8,0.5,-8)
	end
	local function commit(v)
		setVisual(v)
		if cb then cb(v) end
		if flag then Odyssey.Flags[flag]=v end
	end
	local function fromX(x)
		local p=math.clamp((x-trackF.AbsolutePosition.X)/math.max(trackF.AbsoluteSize.X,1),0,1)
		local v=math.floor((minV+p*(maxV-minV))/inc+0.5)*inc
		return math.clamp(v,minV,maxV)
	end
	local dragging=false
	local function begin(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
			dragging=true
			commit(fromX(i.Position.X))
		end
	end
	holder.InputBegan:Connect(begin)
	thumbBtn.InputBegan:Connect(begin)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dragging=false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
			commit(fromX(i.Position.X))
		end
	end)
	valLbl.FocusLost:Connect(function()
		local n=tonumber(valLbl.Text)
		if not n then valLbl.Text=fmt(defV) return end
		local v=math.clamp(math.floor(n/inc+0.5)*inc,minV,maxV)
		commit(v)
	end)
	reg(self,opts.Name,card)
	local api={}
	function api:Set(o)
		if o.Value then setVisual(math.clamp(o.Value,minV,maxV)) end
	end
	function api:GetValue() return tonumber(valLbl.Text) end
	function api:Destroy() card:Destroy() end
	if flag then Odyssey.Flags[flag]=defV end
	return api
end

function Tab:CreateInput(opts)

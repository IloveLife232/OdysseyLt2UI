		for _,b in ipairs(optBtns) do b:Destroy() end
		optBtns={}
		for _,opt in ipairs(list) do
			local s=isSel(opt)
			local ob=New("TextButton",{Text=opt,TextSize=10,TextColor3=T.Text,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=s and 0.8 or 1,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,24),TextXAlignment=Enum.TextXAlignment.Left,AutoButtonColor=false,Parent=optF})

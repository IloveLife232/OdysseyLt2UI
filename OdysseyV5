	pcall(function()
		local ferry=workspace:WaitForChild("Ferry",10)
		if not ferry then return end
		local moving=ferry:WaitForChild("Moving",5)
		local timeToDep=ferry:WaitForChild("TimeToDeparture",5)
		local function upFerry()
			if moving.Value then
				ferryStatusV.Text="Departure"
				ferryTimerV.Text="Sailing"
			else
				ferryStatusV.Text="Docked"
				ferryTimerV.Text=formatTime(timeToDep.Value)
			end
		end
		upFerry()
		moving.Changed:Connect(upFerry)
		timeToDep.Changed:Connect(upFerry)
	end)
	pcall(function()
		local ls=LocalPlayer:WaitForChild("leaderstats",5)
		local money=ls:WaitForChild("Money",5)
		lt2MoneyV.Text=formatMoney(money.Value)
		money.Changed:Connect(function(v) lt2MoneyV.Text=formatMoney(v) end)
	end)

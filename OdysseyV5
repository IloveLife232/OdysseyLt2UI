	Corner(yesBtn,9)

	local step=1
	local function cancel()
		overlay:Destroy()
		if copts.OnCancel then copts.OnCancel() end
		self_win:Notify({Title="Canceled",Content="Action was canceled.",Duration=3})
	end

	noBtn.MouseButton1Click:Connect(cancel)
	yesBtn.MouseButton1Click:Connect(function()
		if step==1 then
			step=2
			warnLbl.Text=copts.Warning2 or "Are you absolutely sure? This cannot be undone."
		else
			overlay:Destroy()
			if copts.OnConfirm then copts.OnConfirm() end
		end
	end)
end


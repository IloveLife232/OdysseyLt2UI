                thumb.Position=UDim2.new(0,3,0.5,-6); thumb.BackgroundColor3=Color3.fromRGB(180,180,200)
            end
        end
    end
    function api:GetValue() return enabled end; function api:Destroy() row:Destroy() end
    if flag then Odyssey.Flags[flag]=enabled end; return api
end

function Tab:CreateSlider(opts)
    opts=opts or {}
    local range=opts.Range or {0,100}; local minV,maxV=range[1],range[2]
    local inc=opts.Increment or 1; local defV=opts.CurrentValue or minV
    local cb=opts.Callback; local flag=opts.Flag
    local row=_row(self._list,self._order); self._order=self._order+1
    local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row}); VList(vl,5)
    local topRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,16),Parent=vl})
    New("TextLabel",{Text=opts.Name or "Slider",TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamMedium,BackgroundTransparency=1,Size=UDim2.new(0.7,0,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=topRow})
    local valLbl=New("TextLabel",{Text=tostring(defV),TextSize=11,TextColor3=T.Accent,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(0.3,0,1,0),TextXAlignment=Enum.TextXAlignment.Right,Parent=topRow})
    -- Glass track
    local trackF=New("Frame",{Size=UDim2.new(1,0,0,5),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.88,BorderSizePixel=0,Parent=vl}); Corner(trackF,3)
    local pct=(defV-minV)/(maxV-minV)
    local fill=New("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=T.Accent,BorderSizePixel=0,Parent=trackF}); Corner(fill,3)
    local thumbBtn=New("TextButton",{Text="",Size=UDim2.new(0,14,0,14),Position=UDim2.new(pct,-7,0.5,-7),BackgroundColor3=Color3.fromRGB(255,255,255),BorderSizePixel=0,AutoButtonColor=false,Parent=trackF}); Corner(thumbBtn,7)
    GlassStroke(thumbBtn,0.5)
    if opts.Tooltip then AddTooltip(topRow,opts.Tooltip,true,topRow) end
    _div(self._list,self._order); self._order=self._order+1
    local dragging=false
    thumbBtn.MouseButton1Down:Connect(function() dragging=true end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
            local p=math.clamp((i.Position.X-trackF.AbsolutePosition.X)/trackF.AbsoluteSize.X,0,1)
            local v=math.floor((minV+p*(maxV-minV))/inc+0.5)*inc; v=math.clamp(v,minV,maxV)
            valLbl.Text=tostring(v); fill.Size=UDim2.new(p,0,1,0); thumbBtn.Position=UDim2.new(p,-7,0.5,-7)
            if cb then cb(v) end; if flag then Odyssey.Flags[flag]=v end
        end
    end)
    local api={}
    function api:Set(o) if o.Value then local v=math.clamp(o.Value,minV,maxV); local p=(v-minV)/(maxV-minV); valLbl.Text=tostring(v); fill.Size=UDim2.new(p,0,1,0); thumbBtn.Position=UDim2.new(p,-7,0.5,-7) end end
    function api:GetValue() return tonumber(valLbl.Text) end; function api:Destroy() row:Destroy() end
    if flag then Odyssey.Flags[flag]=defV end; return api
end


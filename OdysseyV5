local lt2ThemeEnabled = true
local currentLT2BG = Color3.fromRGB(38,38,40)

local function ApplyLT2Theme(bgColor, enabled)
    if not enabled then return end
    local TxtColor = Color3.fromRGB(255,255,255)
    for _,v in next, Players.LocalPlayer.PlayerGui:GetChildren() do
        if v.Name ~= "Chat" and v.Name ~= "TargetGui" and v.Name ~= "LoadingScreen" and v.Name ~= "Blueprints" and v.Name ~= "OdysseyUI" and v.Name ~= "OdysseyTip" and v.Name ~= "OdysseyNotif" then
            for _,d in next, v:GetDescendants() do
                if not d:FindFirstChild("UICorner") then
                    if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("ScrollingFrame") then
                        Instance.new("UICorner",d).CornerRadius=UDim.new(0,6)
                    end
                end
                if d.Name=="DropShadow" then d:Destroy() end
                if d:IsA("TextButton") or d:IsA("Frame") or d:IsA("ScrollingFrame") then
                    d.BackgroundColor3=bgColor
                end
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    d.TextColor3=TxtColor
                    d.BackgroundColor3=bgColor
                    d.Font=Enum.Font.GothamMedium
                end
            end
        end
    end
end

-- Registry of themed UI elements for live recolor
local ThemeRegistry = {
    BG={}, BG1={}, BG2={}, BG3={}, Border={}, Accent={}, AccentDim={},
    Green={}, GreenDim={}, Text={}, TextDim={}, TextMuted={},
}
local function RegisterEl(frame, key)
    if not ThemeRegistry[key] then ThemeRegistry[key]={} end
    table.insert(ThemeRegistry[key], frame)
end

-- Map old color -> theme key for recoloring
local ColorKeyMap = {}
local function BuildColorMap(theme)
    ColorKeyMap = {}
    for k,v in pairs(theme) do
        if k ~= "LT2BG" then
            ColorKeyMap[v] = k
        end
    end
end

local OdysseyGui = nil -- set after GUI is created

local function ApplyTheme(name)
    local theme = Themes[name]
    if not theme then return end

    -- Build map of old colors -> keys BEFORE updating T
    BuildColorMap(T)

    -- Now update T values
    for k,v in pairs(theme) do
        if k ~= "LT2BG" then T[k]=v end
    end

    -- Recolor all Odyssey GUI descendants
    if OdysseyGui then
        for _,obj in ipairs(OdysseyGui:GetDescendants()) do
            pcall(function()
                if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                    local key = ColorKeyMap[obj.BackgroundColor3]
                    if key and T[key] then obj.BackgroundColor3 = T[key] end
                elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                    local bgKey = ColorKeyMap[obj.BackgroundColor3]
                    if bgKey and T[bgKey] then obj.BackgroundColor3 = T[bgKey] end
                    local txtKey = ColorKeyMap[obj.TextColor3]
                    if txtKey and T[txtKey] then obj.TextColor3 = T[txtKey] end
                elseif obj:IsA("UIStroke") then
                    local key = ColorKeyMap[obj.Color]
                    if key and T[key] then obj.Color = T[key] end
                end
            end)
        end
    end

    currentLT2BG = theme.LT2BG
    ApplyLT2Theme(theme.LT2BG, lt2ThemeEnabled)
end


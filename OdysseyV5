local TipFrame, TipLbl, OdysseyMainRef

local function c3key(c) return math.floor(c.R*255).."_"..math.floor(c.G*255).."_"..math.floor(c.B*255) end

local function ApplyTheme(name)
    local theme = Themes[name]
    if not theme then return end
    local colorMap = {}
    for k,v in pairs(theme) do
        if k~="LT2BG" and T[k] then colorMap[c3key(T[k])]=v end
    end
    for k,v in pairs(theme) do
        if k~="LT2BG" then T[k]=v end
    end
    if OdysseyMainRef then
        local gui = OdysseyMainRef.Parent
        if gui then
            for _,obj in ipairs(gui:GetDescendants()) do
                pcall(function()
                    if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                        local nc=colorMap[c3key(obj.BackgroundColor3)]; if nc then obj.BackgroundColor3=nc end
                    elseif obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                        local nb=colorMap[c3key(obj.BackgroundColor3)]; if nb then obj.BackgroundColor3=nb end
                        local nt=colorMap[c3key(obj.TextColor3)]; if nt then obj.TextColor3=nt end
                    elseif obj:IsA("UIStroke") then
                        local nc=colorMap[c3key(obj.Color)]; if nc then obj.Color=nc end
                    end
                end)
            end
        end
    end
    currentLT2BG=theme.LT2BG or currentLT2BG
    ApplyLT2Theme(currentLT2BG)
end

-- ============================================================
-- UTILS
-- ============================================================
local function New(class, props)
    local o = Instance.new(class)
    for k,v in pairs(props) do o[k]=v end
    return o
end

local function Corner(p, r)
    local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r or 8); c.Parent=p
end

-- Glass stroke: white at low transparency
local function GlassStroke(p, alpha)
    local s=Instance.new("UIStroke")
    s.Color=Color3.fromRGB(255,255,255)
    s.Thickness=1
    s.Transparency=alpha or 0.85
    s.Parent=p
    return s
end

local function Stroke(p, col, th, alpha)
    local old=p:FindFirstChildWhichIsA("UIStroke"); if old then old:Destroy() end
    local s=Instance.new("UIStroke")
    s.Color=col or Color3.fromRGB(255,255,255)
    s.Thickness=th or 1
    s.Transparency=alpha or 0.85
    s.Parent=p
    return s
end

local function Pad(p,t,r,b,l)
    local u=Instance.new("UIPadding")
    u.PaddingTop=UDim.new(0,t or 8); u.PaddingRight=UDim.new(0,r or 8)
    u.PaddingBottom=UDim.new(0,b or 8); u.PaddingLeft=UDim.new(0,l or 8)
    u.Parent=p
end

local function VList(p,gap)
    local l=Instance.new("UIListLayout")
    l.FillDirection=Enum.FillDirection.Vertical
    l.Padding=UDim.new(0,gap or 6)
    l.SortOrder=Enum.SortOrder.LayoutOrder
    l.Parent=p
    return l
end

local function MakeDraggable(frame,handle)
    local drag,start,spos=false
    handle.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true;start=i.Position;spos=frame.Position end
    end)
    handle.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
            local d=i.Position-start
            frame.Position=UDim2.new(spos.X.Scale,spos.X.Offset+d.X,spos.Y.Scale,spos.Y.Offset+d.Y)
        end
    end)
end

local function formatTime(s) return string.format("%d:%02d",math.floor(s/60),s%60) end
local function formatMoney(n)
    n=math.floor(tonumber(n) or 0); local s=tostring(n); local result=""; local len=#s
    for i=1,len do if i>1 and (len-i+1)%3==0 then result=result.."," end; result=result..s:sub(i,i) end
    return result
end


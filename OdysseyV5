		if blurLoopActive then return end
		blurLoopActive=true
		task.spawn(function()
			local cycles=0
			while blurIdentityEnabled do
				BlurPlayerGuiPass()
				cycles+=1
				if cycles%4==0 then BlurWorkspacePass() end
				task.wait(1.5)
			end
			blurLoopActive=false
		end)
	end
	Odyssey._RefreshIdentityDisplay=RefreshIdentityDisplay
	Odyssey._SetBlurIdentity=function(v)
		blurIdentityEnabled=v
		RefreshIdentityDisplay()
		if v then StartBlurLoop() end
		pcall(function()
			game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, not v)
		end)
	end
	pcall(function()
		realDisplayName=LocalPlayer.DisplayName~="" and LocalPlayer.DisplayName or "N/A"
		realUsername=LocalPlayer.Name
		realUserId=tostring(LocalPlayer.UserId)
		local age=LocalPlayer.AccountAge
		ageV.Text=formatMoney(age).." days"
		RefreshIdentityDisplay()
	end)

	-- ===== Live values =====
	-- Stats refresh twice a second (not every frame) and only when the text actually changes
	local joinTime=tick()
	local frames=0
	RunService.RenderStepped:Connect(function() frames=frames+1 end)
	local function setText(lbl,txt) if lbl.Text~=txt then lbl.Text=txt end end
	task.spawn(function()
		local last=tick()
		while tab._list.Parent do
			task.wait(0.5)
			pcall(function()
				local now=tick()
				local fps=math.floor(frames/math.max(now-last,0.001)+0.5)
				frames=0; last=now
				if not tab._tabData.page.Visible or (self._main and not self._main.Visible) then return end
				local char=LocalPlayer.Character
				local hum=char and char:FindFirstChildWhichIsA("Humanoid")
				if hum then
					setText(hVal,math.floor(hum.Health).." / "..math.floor(hum.MaxHealth))
					hBar.Size=UDim2.new(math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1),0,1,0)
				end
				setText(pingTile,math.floor(LocalPlayer:GetNetworkPing()*1000).." ms")
				setText(fpsTile,tostring(fps))
				srvAgeV.Text=formatTime(math.floor(now-joinTime))
				setText(playersV,#Players:GetPlayers().." / "..Players.MaxPlayers)
			end)
		end
	end)
	task.spawn(function()
		pcall(function()
			local ls=LocalPlayer:WaitForChild("leaderstats",5)
			local money=ls:WaitForChild("Money",5)
			mVal.Text="$"..formatMoney(money.Value)
			money.Changed:Connect(function(v) mVal.Text="$"..formatMoney(v) end)
		end)
	end)
	task.spawn(function()
		pcall(function()
			local ferry=workspace:WaitForChild("Ferry",10)
			if not ferry then return end
			local moving=ferry:WaitForChild("Moving",5)
			local timeToDep=ferry:WaitForChild("TimeToDeparture",5)
			local function upFerry()
				if moving.Value then ferryV.Text="Sailing"
				else ferryV.Text=formatTime(timeToDep.Value) end
			end
			upFerry()
			moving.Changed:Connect(upFerry)
			timeToDep.Changed:Connect(upFerry)
		end)
	end)
	task.spawn(function()
		pcall(function()
			local noticeGUI=PlayerGui:WaitForChild("NoticeGUI",10)
			local noticeOpen=noticeGUI:WaitForChild("NoticeOpen",5)
			local noticeText=noticeGUI.Notice.Main.TextLabel
			local slotCD=0
			local slotActive=false
			local function startCD(s) slotCD=s; slotActive=true end
			local function checkNotice()
				local t=noticeText.Text
				if t:find("load again") then
					local s=t:match("Wait (%d+) seconds")
					if s then startCD(tonumber(s)) end
				end
			end
			local loadSaveGui=PlayerGui:WaitForChild("LoadSaveGUI",10)
			if loadSaveGui then
				local isOpen=loadSaveGui:WaitForChild("IsOpen",5)
				local wasOpen=false
				isOpen.Changed:Connect(function(v)
					if not v and wasOpen and not slotActive then startCD(60) end
					wasOpen=v
				end)
			end
			noticeOpen.Changed:Connect(function(v) if v then checkNotice() end end)
			noticeText:GetPropertyChangedSignal("Text"):Connect(function() if noticeOpen.Value then checkNotice() end end)
			RunService.Heartbeat:Connect(function(dt)
				if slotActive and slotCD>0 then
					slotCD=slotCD-dt
					slotTimerV.Text=formatTime(math.max(0,math.ceil(slotCD)))
					if slotCD<=0 then slotActive=false; slotTimerV.Text="Ready" end
				end
			end)
		end)
	end)
	self._homeList=list
	self._homeOrder=10
	return tab
end


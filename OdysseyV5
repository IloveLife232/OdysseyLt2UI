-- Standalone floating progress bar — its own glass panel, separate from the tabbed
-- window, positioned bottom-left of the screen. Automatically follows whatever
-- theme is active, and can be relabeled/reused across a sequence of tasks.
-- local pb = Window:CreateProgressWidget({Name="Selling Wood...", CurrentValue=0})
-- pb:Set({Value=50})
-- pb:Set({Name="Selling Planks...", Value=0})
-- pb:Destroy() -- removes it when done
function Window:CreateProgressWidget(opts)
	opts=opts or {}
	local range=opts.Range or {0,100}
	local minV,maxV=range[1],range[2]
	local val=math.clamp(opts.CurrentValue or minV,minV,maxV)
	local showPercent=opts.ShowPercent

	local pg=New("ScreenGui",{Name="OdysseyProgress",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,Parent=PlayerGui})
	local box=New("Frame",{Size=UDim2.new(0,260,0,0),AutomaticSize=Enum.AutomaticSize.Y,Position=UDim2.new(0.5,-130,0,16),AnchorPoint=Vector2.new(0,0),BackgroundColor3=Color3.fromRGB(255,255,255),BorderSizePixel=0,Parent=pg})
	Corner(box,14); GlassStroke(box,0.5); Pad(box,12,14,12,14)
	box.BackgroundTransparency=0.05
	local grad=Instance.new("UIGradient")
	grad.Color=ColorSequence.new({
		ColorSequenceKeypoint.new(0,currentThemeColors.c1),
		ColorSequenceKeypoint.new(0.5,currentThemeColors.c2),
		ColorSequenceKeypoint.new(1,currentThemeColors.c3),
	})
	grad.Rotation=120
	grad.Parent=box
	ProgressBarGradients[grad]=true

	local vl=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=box})
	VList(vl,7)
	local nameRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,14),Parent=vl})
	local nameLbl=New("TextLabel",{Text=opts.Name or "Progress",TextSize=11,TextColor3=Color3.fromRGB(255,255,255),Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(1,-54,1,0),TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=nameRow})
	local function pctText()
		local p=math.floor(((val-minV)/(maxV-minV))*100+0.5)
		if showPercent then return p.."%" end
		return math.floor(val).."/"..math.floor(maxV)
	end
	local valLbl=New("TextLabel",{Text=pctText(),TextSize=11,TextColor3=Color3.fromRGB(255,255,255),Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(0,50,1,0),Position=UDim2.new(1,-50,0,0),TextXAlignment=Enum.TextXAlignment.Right,Parent=nameRow})
	local track=New("Frame",{Size=UDim2.new(1,0,0,8),BackgroundColor3=Color3.fromRGB(0,0,0),BackgroundTransparency=0.68,BorderSizePixel=0,Parent=vl})
	Corner(track,5)
	local pct0=(val-minV)/(maxV-minV)
	local fill=New("Frame",{Size=UDim2.new(pct0,0,1,0),BackgroundColor3=Color3.fromRGB(255,255,255),BorderSizePixel=0,Parent=track})
	Corner(fill,5)

	local api={}
	function api:Set(o)
		if o.Name~=nil then nameLbl.Text=o.Name end
		if o.Range~=nil then minV=o.Range[1]; maxV=o.Range[2] end
		if o.Value~=nil then
			val=math.clamp(o.Value,minV,maxV)
			local p=(val-minV)/(maxV-minV)
			TweenService:Create(fill,TweenInfo.new(0.2),{Size=UDim2.new(p,0,1,0)}):Play()
			valLbl.Text=pctText()
		end
	end
	function api:GetValue() return val end
	function api:Destroy() ProgressBarGradients[grad]=nil; pg:Destroy() end
	return api
end

function Window:CreateUpdateLog(opts)
	opts=opts or {}
	local parent=self._homeList or self._contentScroll
	self._homeOrder=(self._homeOrder or 10)+1
	local f=New("Frame",{BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.82,BorderSizePixel=0,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,LayoutOrder=self._homeOrder,Parent=parent})
	Corner(f,12); GlassStroke(f,0.65); Pad(f,11,14,11,14)
	local vl=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=f})
	VList(vl,5)
	local hRow=New("Frame",{Size=UDim2.new(1,0,0,16),BackgroundTransparency=1,LayoutOrder=0,Parent=vl})
	New("TextLabel",{Text="Update log",TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(0.6,0,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=hRow})
	New("TextLabel",{Text=(opts.Version or "v1.0.0").."  |  "..(opts.Date or ""),TextSize=9,TextColor3=T.TextMuted,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(0.4,0,1,0),TextXAlignment=Enum.TextXAlignment.Right,Parent=hRow})

	-- Normalizes short type codes (add/fix/chg/rmv etc) into one of 4 fixed categories
	local function NormalizeType(t)
		t=(t or ""):lower()
		if t=="add" or t=="added" or t=="new" then return "Added" end
		if t=="fix" or t=="fixed" or t=="bugfix" then return "Fixed" end
		if t=="chg" or t=="change" or t=="changed" or t=="update" or t=="updated" then return "Changed" end
		if t=="rmv" or t=="rem" or t=="remove" or t=="removed" or t=="delete" or t=="deleted" then return "Removed" end
		return "Changed"
	end

	local categoryOrder={"Added","Fixed","Changed","Removed"}
	local grouped={Added={},Fixed={},Changed={},Removed={}}
	for _,e in ipairs(opts.Entries or {}) do
		local cat=NormalizeType(e.Type)
		table.insert(grouped[cat],e)
	end

	local order=1
	for _,category in ipairs(categoryOrder) do
		local entries=grouped[category]
		if #entries>0 then
			New("Frame",{Size=UDim2.new(1,0,0,1),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,LayoutOrder=order,Parent=vl})
			order=order+1
			New("TextLabel",{Text=category:upper(),TextSize=8,TextColor3=T.TextMuted,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(1,0,0,12),LayoutOrder=order,TextXAlignment=Enum.TextXAlignment.Left,Parent=vl})
			order=order+1
			for _,e in ipairs(entries) do
				local er=New("Frame",{Size=UDim2.new(1,0,0,20),BackgroundTransparency=1,LayoutOrder=order,Parent=vl})
				order=order+1
				local dot=New("Frame",{Size=UDim2.new(0,6,0,6),Position=UDim2.new(0,0,0.5,-3),BackgroundColor3=T.Text,BorderSizePixel=0,Parent=er})
				Corner(dot,3)
				New("TextLabel",{Text=e.Text or "",TextSize=10,TextColor3=T.TextDim,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),Position=UDim2.new(0,12,0,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=er})
			end
		end
	end
end


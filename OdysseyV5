					selected=opt; open=false; body.Visible=false; arrow.Text="v"
				end
				header.Text=selText()
				build(list)
				if cb then cb(selected) end
			end)
			table.insert(optBtns,ob)
		end
	end
	build(options)
	sb:GetPropertyChangedSignal("Text"):Connect(function()
		local q=sb.Text:lower()
		local f={}
		for _,o in ipairs(options) do if o:lower():find(q,1,true) then table.insert(f,o) end end

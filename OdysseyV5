		local noticeGUI=PlayerGui:WaitForChild("NoticeGUI",10)
		local noticeOpen=noticeGUI:WaitForChild("NoticeOpen",5)
		local noticeText=noticeGUI.Notice.Main.TextLabel
		local slotCD=0
		local slotActive=false
		local function startCD(s) slotCD=s; slotActive=true end
		local function checkNotice()
			local t=noticeText.Text
			if t:find("load again") then
				local s=t:match("Wait (%d+) seconds")
				if s then startCD(tonumber(s)) end
			end
		end
		local loadSaveGui=PlayerGui:WaitForChild("LoadSaveGUI",10)
		if loadSaveGui then
			local isOpen=loadSaveGui:WaitForChild("IsOpen",5)
			local wasOpen=false
			isOpen.Changed:Connect(function(v)
				if not v and wasOpen and not slotActive then startCD(60) end
				wasOpen=v
			end)
		end
		noticeOpen.Changed:Connect(function(v) if v then checkNotice() end end)
		noticeText:GetPropertyChangedSignal("Text"):Connect(function() if noticeOpen.Value then checkNotice() end end)
		RunService.Heartbeat:Connect(function(dt)
			if slotActive and slotCD>0 then
				slotCD=slotCD-dt
				slotTimerV.Text=formatTime(math.max(0,math.ceil(slotCD)))
				if slotCD<=0 then
					slotActive=false
					slotTimerV.Text="Ready"
				end
			end
		end)
	end)
	self._homeList=tab._list
	self._homeOrder=10
	return tab
end


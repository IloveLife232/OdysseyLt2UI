	end
	TweenService:Create(f,TweenInfo.new(0.25,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Position=UDim2.new(0,0,0,0)}):Play()
	task.delay(nopts.Duration or 4,function()
		if not wrap.Parent then return end

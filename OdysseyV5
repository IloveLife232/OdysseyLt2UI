function AddStatusBox(title, status, statusColor, parent, order, tip)
    local f=New("Frame",{Size=UDim2.new(0.5,-4,0,44),BackgroundColor3=T.BG3,BorderSizePixel=0,LayoutOrder=order or 0,Parent=parent})

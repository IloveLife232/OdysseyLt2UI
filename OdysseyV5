	local holdActive=false
	keyBtn.MouseButton1Click:Connect(function() awaiting=true; keyBtn.Text="Press a key..." end)
	UserInputService.InputBegan:Connect(function(i,gp)
		if awaiting and not gp then
			if i.UserInputType~=Enum.UserInputType.Keyboard then return end
			current=i.KeyCode.Name
			keyBtn.Text=current
			awaiting=false
		elseif not gp and i.KeyCode.Name==current then

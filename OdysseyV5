local lt2ThemeEnabled=true
local currentLT2BG=Color3.fromRGB(20,110,200)
local currentThemeColors={c1=Color3.fromRGB(10,90,180),c2=Color3.fromRGB(20,150,220),c3=Color3.fromRGB(10,190,210)}
local function ApplyLT2Theme(bgColor)
	if not lt2ThemeEnabled then return end
	local TxtColor=Color3.fromRGB(255,255,255)
	for _,v in next,Players.LocalPlayer.PlayerGui:GetChildren() do
		if v.Name~="Chat" and v.Name~="OdysseyUI" and v.Name~="OdysseyTip" and v.Name~="OdysseyNotif" then
			for _,d in next,v:GetDescendants() do pcall(function()
				if not d:FindFirstChild("UICorner") then
					if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("ScrollingFrame") then
						Instance.new("UICorner",d).CornerRadius=UDim.new(0,8)
					end
				end
				if d.Name=="DropShadow" then d:Destroy() end
				if d:IsA("TextButton") or d:IsA("Frame") or d:IsA("ScrollingFrame") then
					d.BackgroundColor3=bgColor
					d.BackgroundTransparency=0.15
					if not d:FindFirstChildWhichIsA("UIStroke") then
						local s=Instance.new("UIStroke")
						s.Color=Color3.fromRGB(255,255,255)
						s.Thickness=1
						s.Transparency=0.7
						s.Parent=d
					end
				end
				if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
					d.TextColor3=TxtColor; d.Font=Enum.Font.GothamMedium
				end
			end) end
		end
	end
end
Players.LocalPlayer.PlayerGui.ChildAdded:Connect(function() task.wait(0.1); if lt2ThemeEnabled then ApplyLT2Theme(currentLT2BG) end end)
task.defer(function() if lt2ThemeEnabled then ApplyLT2Theme(currentLT2BG) end end)

local TipFrame,TipLbl,OdysseyMainRef,OdysseyGradient
local function ApplyTheme(name)
	local theme=Themes[name]
	if not theme then return end
	if OdysseyGradient then
		OdysseyGradient.Color=ColorSequence.new({
			ColorSequenceKeypoint.new(0,theme.c1),
			ColorSequenceKeypoint.new(0.5,theme.c2),
			ColorSequenceKeypoint.new(1,theme.c3),
		})
	end
	currentLT2BG=theme.LT2BG
	currentThemeColors={c1=theme.c1,c2=theme.c2,c3=theme.c3}
	ApplyLT2Theme(currentLT2BG)
end

local function New(class,props)
	local o=Instance.new(class)
	for k,v in pairs(props) do o[k]=v end
	return o
end
local function Corner(p,r)
	local c=Instance.new("UICorner")
	c.CornerRadius=UDim.new(0,r or 8)
	c.Parent=p
end
local function GlassStroke(p,alpha)
	local s=Instance.new("UIStroke")
	s.Color=Color3.fromRGB(255,255,255)
	s.Thickness=1
	s.Transparency=alpha or 0.75
	s.Parent=p
	return s
end
local function Stroke(p,col,th,alpha)
	local old=p:FindFirstChildWhichIsA("UIStroke")
	if old then old:Destroy() end
	local s=Instance.new("UIStroke")
	s.Color=col or Color3.fromRGB(255,255,255)
	s.Thickness=th or 1
	s.Transparency=alpha or 0.75
	s.Parent=p
	return s
end
local function Pad(p,t,r,b,l)
	local u=Instance.new("UIPadding")
	u.PaddingTop=UDim.new(0,t or 8)
	u.PaddingRight=UDim.new(0,r or 8)
	u.PaddingBottom=UDim.new(0,b or 8)
	u.PaddingLeft=UDim.new(0,l or 8)
	u.Parent=p
end
local function VList(p,gap)
	local l=Instance.new("UIListLayout")
	l.FillDirection=Enum.FillDirection.Vertical
	l.Padding=UDim.new(0,gap or 6)
	l.SortOrder=Enum.SortOrder.LayoutOrder
	l.Parent=p
	return l
end
local function HList(p,gap)
	local l=Instance.new("UIListLayout")
	l.FillDirection=Enum.FillDirection.Horizontal
	l.Padding=UDim.new(0,gap or 10)
	l.SortOrder=Enum.SortOrder.LayoutOrder
	l.VerticalAlignment=Enum.VerticalAlignment.Center
	l.Parent=p
	return l
end
local function MakeDraggable(frame,handle)
	local drag,start,spos=false
	handle.InputBegan:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true;start=i.Position;spos=frame.Position end
	end)
	handle.InputEnded:Connect(function(i)
		if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
			local d=i.Position-start
			frame.Position=UDim2.new(spos.X.Scale,spos.X.Offset+d.X,spos.Y.Scale,spos.Y.Offset+d.Y)
		end
	end)
end
local function formatTime(s) return string.format("%d:%02d",math.floor(s/60),s%60) end
local function formatMoney(n)
	n=math.floor(tonumber(n) or 0)
	local s=tostring(n)
	local result=""
	local len=#s
	for i=1,len do
		if i>1 and (len-i+1)%3==0 then result=result.."," end
		result=result..s:sub(i,i)
	end
	return result
end

local function AddTooltip(obj,text,showIcon,iconParent)
	if not text or text=="" then return end
	local function showTip()
		if not TipLbl or not TipFrame then return end
		TipLbl.Text=text
		if OdysseyMainRef then
			local p=OdysseyMainRef.AbsolutePosition
			local s=OdysseyMainRef.AbsoluteSize
			TipFrame.Position=UDim2.new(0,p.X+s.X+8,0,p.Y+60)
		end
		TipFrame.Visible=true
	end
	if showIcon and iconParent then
		local ib=New("TextButton",{Text="i",TextSize=8,TextColor3=Color3.fromRGB(255,255,255),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,Font=Enum.Font.GothamBold,Size=UDim2.new(0,15,0,15),Position=UDim2.new(1,-17,0.5,-7),AutoButtonColor=false,ZIndex=5,Parent=iconParent})
		Corner(ib,8)
		GlassStroke(ib,0.6)
		ib.MouseEnter:Connect(function() showTip() end)
		ib.MouseLeave:Connect(function() if TipFrame then TipFrame.Visible=false end end)
		return
	end
	obj.MouseEnter:Connect(function() showTip() end)
	obj.MouseLeave:Connect(function() if TipFrame then TipFrame.Visible=false end end)
end

local function _div(parent,order) return New("Frame",{Size=UDim2.new(1,0,0,1),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,LayoutOrder=order or 0,Parent=parent}) end

function Tab:CreateSection(name)
	local row=_row(self._list,self._order); self._order=self._order+1
	New("TextLabel",{Text=name:upper(),TextSize=8,TextColor3=T.TextMuted,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(1,0,0,14),TextXAlignment=Enum.TextXAlignment.Left,Parent=row})
	return setmetatable({_list=self._list,_order=self._order,_tabData=self._tabData,_win=self._win},Tab)
end
function Tab:CreateDivider() _div(self._list,self._order); self._order=self._order+1 end

function Tab:CreateLabel(opts)
	opts=opts or {}
	local colors={T.TextDim,T.Blue,T.Yellow}
	local prefixes={"","i  ","!  "}
	local row=_row(self._list,self._order); self._order=self._order+1
	local lbl=New("TextLabel",{Text=(prefixes[opts.Style or 1] or "")..(opts.Text or ""),TextSize=11,TextColor3=colors[opts.Style or 1] or T.TextDim,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,Parent=row})
	local api={}
	function api:Set(o) if o.Text then lbl.Text=o.Text end end
	function api:Destroy() row:Destroy() end
	return api
end

function Tab:CreateParagraph(opts)
	opts=opts or {}
	local row=_row(self._list,self._order); self._order=self._order+1
	local f=New("Frame",{BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})

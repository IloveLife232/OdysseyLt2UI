    _divider(self._list, self._order); self._order=self._order+1

    local awaiting=false
    keyBtn.MouseButton1Click:Connect(function()
        awaiting=true; keyBtn.Text="..."; keyBtn.TextColor3=T.TextDim
    end)

    local holdActive=false
    UserInputService.InputBegan:Connect(function(i,gp)
        if awaiting and not gp then
            current=i.KeyCode.Name; keyBtn.Text=current; keyBtn.TextColor3=T.Accent; awaiting=false
        elseif not gp and i.KeyCode.Name==current then
            if hold then holdActive=true; if cb then cb(true) end
            else if cb then cb() end end
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if hold and i.KeyCode.Name==current and holdActive then holdActive=false; if cb then cb(false) end end
    end)

    local api={}
    function api:Set(o) if o.KeyCode then current=o.KeyCode.Name; keyBtn.Text=current end end
    function api:GetValue() return current end
    function api:Destroy() row:Destroy() end
    return api
end


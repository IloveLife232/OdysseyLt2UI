        btn.BackgroundTransparency=0; btn.BackgroundColor3=self._T.BG2; btn.TextColor3=self._T.Text; bar.Visible=true; page.Visible=true
    end)

    local tabObj = setmetatable({_list=listFrame, _order=0, _T=self._T}, Tab)

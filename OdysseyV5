function Tab:CreateToggle(opts)
	opts=opts or {}
	local enabled=opts.CurrentValue or false
	local cb=opts.Callback
	local flag=opts.Flag
	local row=_row(self._list,self._order); self._order=self._order+1
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
	VList(vl,3)
	local topRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,28),Parent=vl})
	New("TextLabel",{Text=opts.Name or "Toggle",TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamMedium,BackgroundTransparency=1,Size=UDim2.new(1,-44,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=topRow})
	local track=New("Frame",{Size=UDim2.new(0,32,0,18),Position=UDim2.new(1,-32,0.5,-9),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=enabled and 0.05 or 0.82,BorderSizePixel=0,Parent=topRow})
	Corner(track,9); GlassStroke(track,0.6)
	local thumb=New("Frame",{Size=UDim2.new(0,12,0,12),Position=enabled and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,3,0.5,-6),BackgroundColor3=enabled and Color3.fromRGB(30,30,30) or Color3.fromRGB(255,255,255),BorderSizePixel=0,Parent=track})
	Corner(thumb,6)
	if opts.Description then New("TextLabel",{Text=opts.Description,TextSize=9,TextColor3=T.TextMuted,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,Parent=vl}) end
	_div(self._list,self._order); self._order=self._order+1
	local hit=New("TextButton",{Text="",BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),Parent=topRow})
	if opts.Tooltip then AddTooltip(topRow,opts.Tooltip) end
	hit.MouseButton1Click:Connect(function()
		enabled=not enabled
		local ti=TweenInfo.new(0.15)
		if enabled then
			TweenService:Create(track,ti,{BackgroundTransparency=0.05}):Play()
			TweenService:Create(thumb,ti,{Position=UDim2.new(1,-14,0.5,-6),BackgroundColor3=Color3.fromRGB(30,30,30)}):Play()
		else
			TweenService:Create(track,ti,{BackgroundTransparency=0.82}):Play()
			TweenService:Create(thumb,ti,{Position=UDim2.new(0,3,0.5,-6),BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
		end
		if cb then cb(enabled) end
		if flag then Odyssey.Flags[flag]=enabled end
	end)
	local api={}
	function api:Set(o)
		if o.CurrentValue~=nil then
			enabled=o.CurrentValue
			if enabled then
				track.BackgroundTransparency=0.05
				thumb.Position=UDim2.new(1,-14,0.5,-6)
				thumb.BackgroundColor3=Color3.fromRGB(30,30,30)
			else
				track.BackgroundTransparency=0.82
				thumb.Position=UDim2.new(0,3,0.5,-6)
				thumb.BackgroundColor3=Color3.fromRGB(255,255,255)
			end
		end
	end
	function api:GetValue() return enabled end
	function api:Destroy() row:Destroy() end
	if flag then Odyssey.Flags[flag]=enabled end
	return api
end

function Tab:CreateSlider(opts)
	opts=opts or {}
	local range=opts.Range or {0,100}
	local minV,maxV=range[1],range[2]
	local inc=opts.Increment or 1
	local defV=opts.CurrentValue or minV
	local cb=opts.Callback
	local flag=opts.Flag
	local row=_row(self._list,self._order); self._order=self._order+1
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
	VList(vl,5)
	local topRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,16),Parent=vl})
	New("TextLabel",{Text=opts.Name or "Slider",TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamMedium,BackgroundTransparency=1,Size=UDim2.new(0.7,0,1,0),TextXAlignment=Enum.TextXAlignment.Left,Parent=topRow})
	local valLbl=New("TextLabel",{Text=tostring(defV),TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamBold,BackgroundTransparency=1,Size=UDim2.new(0.3,0,1,0),TextXAlignment=Enum.TextXAlignment.Right,Parent=topRow})
	local trackF=New("Frame",{Size=UDim2.new(1,0,0,5),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.82,BorderSizePixel=0,Parent=vl})
	Corner(trackF,3)
	local pct=(defV-minV)/(maxV-minV)
	local fill=New("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=Color3.fromRGB(255,255,255),BorderSizePixel=0,Parent=trackF})
	Corner(fill,3)
	local thumbBtn=New("TextButton",{Text="",Size=UDim2.new(0,14,0,14),Position=UDim2.new(pct,-7,0.5,-7),BackgroundColor3=Color3.fromRGB(255,255,255),BorderSizePixel=0,AutoButtonColor=false,Parent=trackF})
	Corner(thumbBtn,7)
	if opts.Tooltip then AddTooltip(topRow,opts.Tooltip) end
	_div(self._list,self._order); self._order=self._order+1
	local dragging=false
	thumbBtn.MouseButton1Down:Connect(function() dragging=true end)
	UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
			local p=math.clamp((i.Position.X-trackF.AbsolutePosition.X)/trackF.AbsoluteSize.X,0,1)
			local v=math.floor((minV+p*(maxV-minV))/inc+0.5)*inc
			v=math.clamp(v,minV,maxV)
			valLbl.Text=tostring(v)
			fill.Size=UDim2.new(p,0,1,0)
			thumbBtn.Position=UDim2.new(p,-7,0.5,-7)
			if cb then cb(v) end
			if flag then Odyssey.Flags[flag]=v end
		end
	end)
	local api={}
	function api:Set(o)
		if o.Value then
			local v=math.clamp(o.Value,minV,maxV)
			local p=(v-minV)/(maxV-minV)
			valLbl.Text=tostring(v)
			fill.Size=UDim2.new(p,0,1,0)
			thumbBtn.Position=UDim2.new(p,-7,0.5,-7)
		end
	end
	function api:GetValue() return tonumber(valLbl.Text) end
	function api:Destroy() row:Destroy() end
	if flag then Odyssey.Flags[flag]=defV end
	return api
end

function Tab:CreateInput(opts)
	opts=opts or {}
	local cb=opts.Callback
	local enter=opts.Enter or false
	local row=_row(self._list,self._order); self._order=self._order+1
	local vl=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,Parent=row})
	VList(vl,4)
	New("TextLabel",{Text=opts.Name or "Input",TextSize=11,TextColor3=T.Text,Font=Enum.Font.GothamMedium,BackgroundTransparency=1,Size=UDim2.new(1,0,0,14),TextXAlignment=Enum.TextXAlignment.Left,Parent=vl})
	if opts.Description then New("TextLabel",{Text=opts.Description,TextSize=9,TextColor3=T.TextMuted,Font=Enum.Font.Gotham,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,TextXAlignment=Enum.TextXAlignment.Left,TextWrapped=true,Parent=vl}) end
	local tb=New("TextBox",{PlaceholderText=opts.PlaceholderText or "Type here...",Text="",TextSize=11,TextColor3=T.Text,PlaceholderColor3=T.TextMuted,BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.85,BorderSizePixel=0,Font=Enum.Font.Gotham,Size=UDim2.new(1,0,0,28),TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,Parent=vl})
	Corner(tb,8); GlassStroke(tb,0.65); Pad(tb,0,8,0,8)
	if opts.Tooltip then AddTooltip(tb,opts.Tooltip) end
	tb.Focused:Connect(function() Stroke(tb,Color3.fromRGB(255,255,255),1,0.2) end)
	tb.FocusLost:Connect(function(ep)
		GlassStroke(tb,0.65)
		if opts.Numeric then tb.Text=tostring(tonumber(tb.Text) or 0) end
		if opts.MaxCharacters and #tb.Text>opts.MaxCharacters then tb.Text=tb.Text:sub(1,opts.MaxCharacters) end
		if enter and not ep then return end
		if cb then cb(tb.Text) end
	end)
	tb:GetPropertyChangedSignal("Text"):Connect(function()
		if opts.MaxCharacters and #tb.Text>opts.MaxCharacters then tb.Text=tb.Text:sub(1,opts.MaxCharacters) end
		if opts.Numeric then tb.Text=tb.Text:gsub("[^%d%.%-]","") end
		if not enter and cb then cb(tb.Text) end
	end)
	_div(self._list,self._order); self._order=self._order+1
	local api={}
	function api:Set(o) if o.Value then tb.Text=tostring(o.Value) end end
	function api:GetValue() return tb.Text end
	function api:Destroy() row:Destroy() end
	return api
end


-- local pb = Window:CreateProgressWidget({Name="Selling Wood...", CurrentValue=0})
-- pb:Set({Value=50}); pb:Set({Name="Selling Planks...", Value=0}); pb:Destroy()
function Window:CreateProgressWidget(opts)
	opts=opts or {}
	local range=opts.Range or {0,100}
	local minV,maxV=range[1],range[2]
	local val=math.clamp(opts.CurrentValue or minV,minV,maxV)
	local showPercent=opts.ShowPercent
	local pg=New("ScreenGui",{Name="OdysseyProgress",ResetOnSpawn=false,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=40,Parent=PlayerGui})
	local box=New("Frame",{Size=UDim2.new(0,280,0,0),AutomaticSize=Enum.AutomaticSize.Y,AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,16),BackgroundColor3=C.Card,BackgroundTransparency=0.02,BorderSizePixel=0,Parent=pg})
	Corner(box,12); Stroke(box,C.FieldStroke,1,0); Pad(box,12,14,12,14)
	local vl=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,Parent=box})
	VList(vl,8)
	local nameRow=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,16),Parent=vl})
	local nameLbl=New("TextLabel",{Text=opts.Name or "Progress",TextSize=14,TextColor3=C.Text,Font=Enum.Font.BuilderSansBold,BackgroundTransparency=1,Size=UDim2.new(1,-64,1,0),TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd,Parent=nameRow})
	local function pctOf() if maxV==minV then return 0 end return (val-minV)/(maxV-minV) end
	local function pctText()
		if showPercent then return math.floor(pctOf()*100+0.5).."%" end
		return math.floor(val).." / "..math.floor(maxV)
	end
	local valLbl=New("TextLabel",{Text=pctText(),TextSize=13,TextColor3=C.Dim,Font=Enum.Font.BuilderSansBold,BackgroundTransparency=1,Size=UDim2.new(0,64,1,0),Position=UDim2.new(1,-64,0,0),TextXAlignment=Enum.TextXAlignment.Right,Parent=nameRow})
	local track=New("Frame",{Size=UDim2.new(1,0,0,8),BackgroundColor3=C.Track,BorderSizePixel=0,Parent=vl})
	Corner(track,4)
	local fill=New("Frame",{Size=UDim2.new(pctOf(),0,1,0),BackgroundColor3=C.White,BorderSizePixel=0,Parent=track})
	Corner(fill,4)
	local grad=AccentGrad(fill,0)
	local api={}
	function api:Set(o)
		if o.Name~=nil then nameLbl.Text=o.Name end
		if o.Range~=nil then minV=o.Range[1]; maxV=o.Range[2] end
		if o.Value~=nil then
			val=math.clamp(o.Value,minV,maxV)
			TweenService:Create(fill,TweenInfo.new(0.2),{Size=UDim2.new(pctOf(),0,1,0)}):Play()
		end
		valLbl.Text=pctText()
	end
	function api:GetValue() return val end
	function api:Destroy() ProgressBarGradients[grad]=nil; pg:Destroy() end
	return api
end

-- Fills the Home "What's new" card
function Window:CreateUpdateLog(opts)
	opts=opts or {}
	local log=self._log
	if not log then return end
	log.card.Visible=true
	if log.pill then log.pill.Text=opts.Version or "v1.0" end
	local function NormalizeType(t)
		t=(t or ""):lower()
		if t=="add" or t=="added" or t=="new" then return "Added" end
		if t=="fix" or t=="fixed" or t=="bugfix" then return "Fixed" end
		if t=="chg" or t=="change" or t=="changed" or t=="update" or t=="updated" then return "Changed" end
		if t=="rmv" or t=="rem" or t=="remove" or t=="removed" or t=="delete" or t=="deleted" then return "Removed" end
		return "Changed"
	end
	local dotCol=Color3.fromRGB(123,140,255)
	local catColor={Added=dotCol,Fixed=dotCol,Changed=dotCol,Removed=dotCol}
	local grouped={Added={},Fixed={},Changed={},Removed={}}
	for _,e in ipairs(opts.Entries or {}) do table.insert(grouped[NormalizeType(e.Type)],e) end
	local order=100
	for _,category in ipairs({"Added","Fixed","Changed","Removed"}) do
		local entries=grouped[category]
		if #entries>0 then
			for _,e in ipairs(entries) do
				order=order+1
				local er=New("Frame",{Size=UDim2.new(1,0,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1,LayoutOrder=order,Parent=log.list})
				local dot=New("Frame",{Size=UDim2.new(0,6,0,6),Position=UDim2.new(0,0,0,6),BackgroundColor3=catColor[category],BorderSizePixel=0,Parent=er})
				Corner(dot,3)
				New("TextLabel",{Text=e.Text or "",TextSize=13,TextColor3=C.Dim,Font=Enum.Font.BuilderSansMedium,BackgroundTransparency=1,Size=UDim2.new(1,-14,0,0),AutomaticSize=Enum.AutomaticSize.Y,Position=UDim2.new(0,14,0,0),TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left,Parent=er})
			end
		end
	end
end


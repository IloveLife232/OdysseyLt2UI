local DEFAULT_GROUPS={Home="Player",Character="Player",World="Player",
	Property="Base",["Slot Importer"]="Base",Vehicle="Base",Builder="Base",
	Wood="Misc",["Auto Buy"]="Misc",Dupe="Misc"}
-- Sidebar group header: small label + a thin line to the right. One per group,
-- always placed just above the group's first tab (works with any tab Order).
function Window:_groupHeader(group,order)
	self._groupHeaders=self._groupHeaders or {}
	local h=self._groupHeaders[group]
	local lo=order*10-5
	if h then
		if lo<h.LayoutOrder then h.LayoutOrder=lo end
	else
		h=New("Frame",{Name="Group_"..group,BackgroundTransparency=1,Size=UDim2.new(1,0,0,30),LayoutOrder=lo,Parent=self._navScroll})
		local lbl=New("TextLabel",{Text=group:upper(),TextSize=12,TextColor3=C.Muted,Font=Enum.Font.BuilderSansBold,BackgroundTransparency=1,Size=UDim2.new(0,0,0,14),AutomaticSize=Enum.AutomaticSize.X,Position=UDim2.new(0,12,1,-18),Parent=h})
		local line=New("Frame",{BackgroundColor3=C.CardStroke,BorderSizePixel=0,Size=UDim2.new(1,-20,0,1),Position=UDim2.new(0,0,1,-11),Parent=h})
		-- line starts right after the label text
		local function fit() line.Position=UDim2.new(0,lbl.TextBounds.X+20,1,-11); line.Size=UDim2.new(1,-(lbl.TextBounds.X+28),0,1) end
		lbl:GetPropertyChangedSignal("TextBounds"):Connect(fit)
		task.defer(fit)
		self._groupHeaders[group]=h
	end
	-- the very first header doesn't need the extra space above it
	local first,firstLO=nil,math.huge
	for _,g in pairs(self._groupHeaders) do if g.LayoutOrder<firstLO then first,firstLO=g,g.LayoutOrder end end
	for _,g in pairs(self._groupHeaders) do g.Size=UDim2.new(1,0,0,g==first and 22 or 34) end
end

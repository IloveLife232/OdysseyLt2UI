    _div(self._list,self._order); self._order=self._order+1
    local hit=New("TextButton",{Text="",BackgroundTransparency=1,Size=UDim2.new(1,0,1,0),Parent=topRow})
    if opts.Tooltip then AddTooltip(topRow,opts.Tooltip,true,topRow) end
    hit.MouseButton1Click:Connect(function()
        enabled=not enabled
        local ti=TweenInfo.new(0.15)
        if enabled then
            TweenService:Create(track,ti,{BackgroundColor3=T.Accent,BackgroundTransparency=0}):Play()
            TweenService:Create(thumb,ti,{Position=UDim2.new(1,-14,0.5,-6),BackgroundColor3=Color3.fromRGB(255,255,255)}):Play()
        else
            TweenService:Create(track,ti,{BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.88}):Play()
            TweenService:Create(thumb,ti,{Position=UDim2.new(0,3,0.5,-6),BackgroundColor3=Color3.fromRGB(180,180,200)}):Play()
        end
        if cb then cb(enabled) end; if flag then Odyssey.Flags[flag]=enabled end
    end)

    return row
end

local function Slider(labelTxt,minV,maxV,defV,parent,order,tip)
    local row=New("Frame",{
        Size=UDim2.new(1,0,0,40),BackgroundTransparency=1,LayoutOrder=order or 0,Parent=parent,
    })
    local lbl=Lbl(labelTxt,12,T.Text,Enum.Font.GothamMedium)
    lbl.Size=UDim2.new(0.7,0,0,16); lbl.Parent=row
    local valLbl=Lbl(tostring(defV),12,T.Accent,Enum.Font.GothamBold,Enum.TextXAlignment.Right)
    valLbl.Size=UDim2.new(0.3,0,0,16); valLbl.Parent=row
    local track=New("Frame",{
        Size=UDim2.new(1,0,0,5),Position=UDim2.new(0,0,0,22),
        BackgroundColor3=T.BG3,BorderSizePixel=0,Parent=row,
    })
    Corner(track,3)
    local pct=(defV-minV)/(maxV-minV)
    local fill=New("Frame",{Size=UDim2.new(pct,0,1,0),BackgroundColor3=T.Accent,BorderSizePixel=0,Parent=track})
    Corner(fill,3)
    local thumb=Btn("",0,T.Text,T.Accent)
    thumb.Size=UDim2.new(0,13,0,13); thumb.Position=UDim2.new(pct,-6,0.5,-6)
    thumb.BorderSizePixel=0; thumb.Parent=track; Corner(thumb,7)
    if tip then AddTooltip(row,tip) end
    local dragging=false
    thumb.MouseButton1Down:Connect(function() dragging=true end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
            local rx=i.Position.X-track.AbsolutePosition.X
            local p2=math.clamp(rx/track.AbsoluteSize.X,0,1)
            local v=math.floor(minV+p2*(maxV-minV))
            valLbl.Text=tostring(v)
            fill.Size=UDim2.new(p2,0,1,0)
            thumb.Position=UDim2.new(p2,-6,0.5,-6)
        end
    end)
    return row
end

